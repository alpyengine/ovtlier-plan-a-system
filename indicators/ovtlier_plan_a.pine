// ═══════════════════════════════════════════════════════════════
// © Ovtlier University | Plan A Swing Indicator v5.1
// Basado en la metodología de Christopher Uhl
// Temporalidades: Daily (D) y Weekly (W)
// v5.1: Paleta clara (misma que Market Dashboard v5.2)
//       Tamaño de texto configurable desde inputs
//       Sin cambios en lógica de negocio ni request.security()
// ═══════════════════════════════════════════════════════════════
//@version=6
indicator("Ovtlier Plan A - Swing v5.1", overlay = true, max_bars_back = 500)

// ─── INPUTS ───────────────────────────────────────────────────

// 📊 Régimen de Mercado — C1
spyEmaLen       = input.int(20,    "EMA Régimen SPY",             group = "📊 Régimen de Mercado C1", minval = 5)
qqqEmaLen       = input.int(20,    "EMA Régimen QQQ",             group = "📊 Régimen de Mercado C1", minval = 5)
useSuperTF      = input.bool(false, "Activar doble TF (C1 superior)", group = "📊 Régimen de Mercado C1",
     tooltip = "ON: verifica que SPY+QQQ también están en régimen alcista en el TF superior.\nDaily -> confirma en Weekly. Weekly -> confirma en Monthly.")
superTFRequired = input.bool(false, "TF superior obligatorio",     group = "📊 Régimen de Mercado C1",
     tooltip = "ON: si el TF superior falla, no hay señal aunque C1 base pase.\nOFF: el TF superior suma 1 punto al score técnico.")

// 📊 Parámetros Técnicos
emaFastLen      = input.int(9,     "EMA Rápida",                  group = "📊 Parámetros Técnicos", minval = 3)
emaSlowLen      = input.int(21,    "EMA Lenta",                   group = "📊 Parámetros Técnicos", minval = 5)
rsiLen          = input.int(14,    "RSI Longitud",                group = "📊 Parámetros Técnicos", minval = 2)
rsiOB           = input.int(40,    "RSI Umbral Sobreventa",       group = "📊 Parámetros Técnicos", minval = 10, maxval = 50)
rsi2Len         = input.int(2,     "RSI-2 Longitud",              group = "📊 Parámetros Técnicos", minval = 1)
rsi2OB          = input.float(10.0,"RSI-2 Umbral",                group = "📊 Parámetros Técnicos", minval = 1.0, maxval = 30.0)
rvolMult        = input.float(1.5, "RVOL Multiplicador",          group = "📊 Parámetros Técnicos", minval = 1.0, step = 0.1)
rvolLen         = input.int(20,    "RVOL Longitud",               group = "📊 Parámetros Técnicos", minval = 5)

// 🎯 C2 Pullback mejorado
c2TrendBars     = input.int(3,     "C2 Barras tendencia previa",  group = "🎯 C2 Pullback Mejorado", minval = 1, maxval = 10,
     tooltip = "Barras anteriores que deben haber cerrado sobre la EMA rápida antes del pullback.\nDefault 3. Rango: 1-10.")

// 📈 Filtro de Tendencia del Activo — C6
sma50Len        = input.int(50,    "SMA Media (defecto 50)",      group = "📈 Filtro Tendencia C6", minval = 10)
sma200Len       = input.int(200,   "SMA Larga (defecto 200)",     group = "📈 Filtro Tendencia C6", minval = 50)
c6Required      = input.bool(false, "C6 obligatoria (además de C1)", group = "📈 Filtro Tendencia C6",
     tooltip = "ON: sin tendencia alcista del activo no hay señal aunque C1 pase.\nOFF: C6 suma al score.")

// 📉 Divergencia RSI — C7
useC7           = input.bool(true,  "Activar C7 Divergencia RSI", group = "📉 Divergencia RSI C7",
     tooltip = "ON: busca divergencia alcista entre precio (LL) y RSI (HL) en la ventana definida.\nOFF: C7 no aparece en tabla ni afecta al score.")
c7Lookback      = input.int(5,     "C7 Ventana barras (lookback)", group = "📉 Divergencia RSI C7", minval = 2, maxval = 20,
     tooltip = "Barras hacia atrás para buscar el mínimo de precio y RSI previo.\nDefault 5. Con más barras detecta divergencias más largas.\nRango: 2-20.")
c7Required      = input.bool(false, "C7 obligatoria",             group = "📉 Divergencia RSI C7",
     tooltip = "ON: sin divergencia RSI no hay señal.\nOFF: C7 suma 1 punto al score (puntuada).")

// ⚠️ Risk Management
atrLen          = input.int(14,    "ATR Longitud",                group = "⚠️ Risk Management", minval = 1)
atrSlMult       = input.float(1.5, "ATR Stop-Loss x",             group = "⚠️ Risk Management", minval = 0.5, step = 0.1)

// 🎨 Visual
showRegime      = input.bool(true,  "Mostrar fondo régimen",      group = "🎨 Visual")
showTable       = input.bool(true,  "Mostrar tabla scoring",      group = "🎨 Visual")
showSL          = input.bool(true,  "Mostrar Stop-Loss",          group = "🎨 Visual")
showDivLine     = input.bool(true,  "Mostrar línea divergencia",  group = "🎨 Visual",
     tooltip = "ON: dibuja una línea en el gráfico conectando los dos mínimos cuando C7 detecta divergencia.")
tamPanelInput   = input.string("small", "Tamaño de texto",
     options = ["tiny", "small", "normal", "large"], group = "🎨 Visual")
tablePosInput   = input.string("Top Right", "Posicion tabla",
     options = ["Top Right", "Top Left", "Top Center", "Bottom Right", "Bottom Left", "Bottom Center", "Middle Right", "Middle Left"],
     group = "🎨 Visual")

// ─── TAMAÑO DE TEXTO ─────────────────────────────────────────
// Resuelve el string del input a la constante size.*
// Se usa TS (text size) en todas las celdas de la tabla.
TS = switch tamPanelInput
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.small

// Una escala por debajo para celdas secundarias (VALOR, modo, versión)
TS_SM = switch tamPanelInput
    "tiny"   => size.tiny
    "small"  => size.tiny
    "normal" => size.small
    "large"  => size.small
    => size.tiny

// ─── POSICIÓN DE TABLA ────────────────────────────────────────
tablePos = switch tablePosInput
    "Top Right"     => position.top_right
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Middle Right"  => position.middle_right
    "Middle Left"   => position.middle_left
    => position.top_right

// ─── PALETA CLARA — misma que Market Dashboard v5.2 ──────────
// Fondos
color C_HEADER_BG   = color.new(#eef0f6, 0)   // th-bg
color C_ROW_BG      = color.new(#ffffff, 0)   // surface
color C_ROW_ALT_BG  = color.new(#f4f5f8, 0)   // surface2
color C_TICKER_BG   = color.new(#eef0f6, 0)   // mismo que header
color C_OBLIG_BG    = color.new(#f0fdf4, 0)   // verde pálido — C1 obligatoria
color C_C6_BG       = color.new(#eff6ff, 0)   // azul pálido  — C6 tendencia
color C_STF_BG      = color.new(#f5f3ff, 0)   // lila pálido  — C1b TF superior
color C_C7_BG       = color.new(#f0fdfa, 0)   // teal pálido  — C7 divergencia

// Textos principales
color C_HEADER_TXT  = color.new(#374151, 0)   // th-text
color C_LABEL_TXT   = color.new(#1a1f2e, 0)   // text
color C_VALUE_TXT   = color.new(#4b5563, 0)   // text2
color C_TICKER_TXT  = color.new(#1d4ed8, 0)   // blue destacado

// Badges PASS
color C_PASS_BG     = color.new(#dcfce7, 0)   // tag-green-bg
color C_PASS_TXT    = color.new(#14532d, 0)   // tag-green-text

// Badges FAIL
color C_FAIL_BG     = color.new(#fee2e2, 0)
color C_FAIL_TXT    = color.new(#991b1b, 0)

// Score / resultado
color C_WARN_BG     = color.new(#fef3c7, 0)   // ambar claro — WATCH
color C_WARN_TXT    = color.new(#b45309, 0)   // texto sobre warn
color C_READY_BG    = color.new(#bbf7d0, 0)   // verde algo más intenso que PASS — READY
color C_READY_TXT   = color.new(#14532d, 0)
color C_NOTREADY_BG = color.new(#fecaca, 0)   // rojo algo más intenso — NOT READY
color C_NOTREADY_TXT = color.new(#991b1b, 0)

// Texto atenuado para filas desactivadas / modo OFF
color C_DIM_TXT     = color.new(#9ca3af, 0)

// ─── HELPER: TF SUPERIOR ─────────────────────────────────────
f_superTF() =>
    if timeframe.isweekly or timeframe.ismonthly
        "M"
    else
        "W"

// ─── CONDICIÓN 1: RÉGIMEN BROAD MARKET (SPY + QQQ) ───────────
// Sin cambios — anti-repainting: close[1] + lookahead_on
[spyClose, spyEma] = request.security("AMEX:SPY", timeframe.period,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqClose, qqqEma] = request.security("NASDAQ:QQQ", timeframe.period,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBull   = spyClose > spyEma
bool qqqBull   = qqqClose > qqqEma
bool c1_regime = spyBull and qqqBull

// ─── C1b: DOBLE TIMEFRAME ────────────────────────────────────
string superTF = f_superTF()

[spyCloseSup, spyEmaSup] = request.security("AMEX:SPY", superTF,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqCloseSup, qqqEmaSup] = request.security("NASDAQ:QQQ", superTF,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBullSup  = spyCloseSup > spyEmaSup
bool qqqBullSup  = qqqCloseSup > qqqEmaSup
bool c1_superTF  = spyBullSup and qqqBullSup
bool superTFGate = not useSuperTF or (superTFRequired ? c1_superTF : true)

// ─── CONDICIÓN 2: PULLBACK CON CONTEXTO DE TENDENCIA ─────────
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)

int barsAboveEma = 0
for i = 1 to c2TrendBars
    if close[i] > emaFast[i]
        barsAboveEma += 1

bool c2_priorTrend = barsAboveEma >= c2TrendBars
bool c2_touchEma   = low <= emaFast and close >= emaSlow * 0.98
bool c2_dip        = c2_priorTrend and c2_touchEma

// ─── CONDICIÓN 3: SOBREVENTA RELATIVA ────────────────────────
float rsiVal  = ta.rsi(close, rsiLen)
float rsi2Val = ta.rsi(close, rsi2Len)
bool  c3_rsi  = rsiVal < rsiOB or rsi2Val < rsi2OB

// ─── CONDICIÓN 4: RVOL ELEVADO ────────────────────────────────
float avgVol    = ta.sma(volume, rvolLen)
float rvolRatio = volume / avgVol
bool  c4_rvol   = rvolRatio > rvolMult

// ─── CONDICIÓN 5: VELA DE REVERSIÓN (HAMMER) ─────────────────
float body    = math.abs(close - open)
float lowerW  = open > close ? (open - low)  : (close - low)
float upperW  = open > close ? (high - open) : (high - close)
bool  c5_candle = lowerW >= 2.0 * body and upperW <= body and body > 0.0

// ─── CONDICIÓN 6: TENDENCIA DEL ACTIVO (SMA 50/200) ──────────
float sma50  = ta.sma(close, sma50Len)
float sma200 = ta.sma(close, sma200Len)

bool c6a_above50  = close > sma50
bool c6b_above200 = close > sma200
bool c6c_golden   = sma50 > sma200
bool c6_trend     = c6a_above50 and c6b_above200 and c6c_golden

float distSma50  = (close - sma50)  / sma50  * 100
float distSma200 = (close - sma200) / sma200 * 100

// ─── CONDICIÓN 7: DIVERGENCIA ALCISTA RSI ─────────────────────
float rsiForDiv = ta.rsi(close, rsiLen)

float priorLow  = ta.lowest(low[1],       c7Lookback)
float priorRsi  = ta.lowest(rsiForDiv[1], c7Lookback)

bool c7_priceLL = low       < priorLow
bool c7_rsiHL   = rsiForDiv > priorRsi
bool c7_divRaw  = c7_priceLL and c7_rsiHL
bool c7_div     = useC7 and c7_divRaw
bool c7Gate     = not useC7 or not c7Required or c7_div

float c7RsiDiff = rsiForDiv - priorRsi

// ─── SCORING ──────────────────────────────────────────────────
int scoreBase    = (c2_dip ? 1 : 0) + (c3_rsi ? 1 : 0) + (c4_rvol ? 1 : 0) + (c5_candle ? 1 : 0) + (c6_trend ? 1 : 0)
int scoreSuperTF = (useSuperTF and not superTFRequired and c1_superTF) ? 1 : 0
int scoreC7      = (useC7 and not c7Required and c7_div) ? 1 : 0
int score        = scoreBase + scoreSuperTF + scoreC7

int scoreMax     = 5 +
     (useSuperTF and not superTFRequired ? 1 : 0) +
     (useC7      and not c7Required      ? 1 : 0)

bool c6Gate        = c6Required ? c6_trend : true
bool fullSignal    = c1_regime and superTFGate and c6Gate and c7Gate and score >= (scoreMax - 1)
bool partialSignal = c1_regime and superTFGate and c6Gate and c7Gate and score == (scoreMax - 2)

// ─── STOP LOSS ────────────────────────────────────────────────
float atrVal  = ta.atr(atrLen)
float slLevel = low - atrSlMult * atrVal
float slPct   = (close - slLevel) / close * 100

// ─── PLOTS (sin cambios vs v5) ────────────────────────────────
bgcolor(showRegime and c1_regime ? color.new(color.teal, 93) : na, title = "Fondo regimen")

plotshape(fullSignal,    "Plan A Signal", shape.triangleup, location.belowbar, color.new(color.teal,   0), size = size.normal, text = "A")
plotshape(partialSignal, "Plan A Watch",  shape.triangleup, location.belowbar, color.new(color.yellow, 0), size = size.small,  text = "~A")

plot(emaFast, "EMA Rapida", color.new(color.blue,   0), 1)
plot(emaSlow, "EMA Lenta",  color.new(color.orange, 0), 2)
plot(sma50,   "SMA 50",     color.new(color.purple, 0), 1)
plot(sma200,  "SMA 200",    color.new(color.yellow, 0), 2)

var line divLine = na
if useC7 and showDivLine and c7_divRaw
    if not na(divLine)
        line.delete(divLine)
    divLine := line.new(
         bar_index - c7Lookback, priorLow,
         bar_index,              low,
         color = color.new(color.lime, 20), width = 1, style = line.style_dashed)

var line slLine = na
if fullSignal
    if not na(slLine)
        line.delete(slLine)
    slLine := showSL ? line.new(bar_index, slLevel, bar_index + 5, slLevel,
         color = color.new(color.red, 20), width = 1, style = line.style_dashed) : na

// ─── HELPERS TABLA ────────────────────────────────────────────
f_badge(bool cond)    => cond ? "OK  PASS" : "X   FAIL"
f_badgeBg(bool cond)  => cond ? C_PASS_BG  : C_FAIL_BG
f_badgeTxt(bool cond) => cond ? C_PASS_TXT : C_FAIL_TXT

// ─── TABLA — 4 columnas x 14 filas ───────────────────────────
// Misma estructura que v5. Solo cambian colores y text_size.
// Todos los text_size usan TS o TS_SM (resueltos desde tamPanelInput).
// border/frame en gris claro para paleta clara.

var table t = table.new(tablePos, 4, 14,
     border_color = color.new(#d1d5db, 0), border_width = 1,
     frame_color  = color.new(#9ca3af, 0), frame_width  = 2)

if showTable and barstate.islast

    // Fila 0 — Cabecera
    table.cell(t, 0, 0, "OVTLIER PLAN A", text_color = C_HEADER_TXT, text_size = TS,    bgcolor = C_HEADER_BG, text_halign = text.align_left)
    table.cell(t, 1, 0, "CONDICION",      text_color = C_HEADER_TXT, text_size = TS,    bgcolor = C_HEADER_BG)
    table.cell(t, 2, 0, "VALOR",          text_color = C_HEADER_TXT, text_size = TS,    bgcolor = C_HEADER_BG)
    table.cell(t, 3, 0, "STATUS",         text_color = C_HEADER_TXT, text_size = TS,    bgcolor = C_HEADER_BG)

    // Fila 1 — Ticker
    table.cell(t, 0, 1, syminfo.ticker,   text_color = C_TICKER_TXT, text_size = TS,    bgcolor = C_TICKER_BG, text_halign = text.align_left)
    table.cell(t, 1, 1, "TF: " + timeframe.period, text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_TICKER_BG)
    table.cell(t, 2, 1, "SPY " + (spyBull ? "OK" : "X") + "  QQQ " + (qqqBull ? "OK" : "X"),
         text_color = c1_regime ? color.new(#15803d, 0) : color.new(#dc2626, 0), text_size = TS_SM, bgcolor = C_TICKER_BG)
    table.cell(t, 3, 1, "",               bgcolor = C_TICKER_BG)

    // Fila 2 — C1 Régimen (obligatoria)
    table.cell(t, 0, 2, "C1 Regimen",    text_color = C_LABEL_TXT,  text_size = TS,    bgcolor = C_OBLIG_BG, text_halign = text.align_left)
    table.cell(t, 1, 2, "SPY+QQQ > EMA " + str.tostring(spyEmaLen), text_color = C_LABEL_TXT, text_size = TS, bgcolor = C_OBLIG_BG)
    table.cell(t, 2, 2, "OBLIGATORIA",   text_color = C_DIM_TXT,    text_size = TS_SM, bgcolor = C_OBLIG_BG)
    table.cell(t, 3, 2, f_badge(c1_regime), text_color = f_badgeTxt(c1_regime), text_size = TS, bgcolor = f_badgeBg(c1_regime))

    // Fila 3 — C1b TF Superior
    string c1bLabel  = useSuperTF ? "C1b TF " + superTF : "C1b TF sup"
    string c1bDesc   = useSuperTF ? "SPY+QQQ > EMA en " + superTF : "Desactivado"
    string c1bMode   = useSuperTF ? (superTFRequired ? "OBLIGATORIA" : "PUNTUADA +1") : "OFF"
    color  c1bRowBg  = useSuperTF ? C_STF_BG : C_ROW_ALT_BG
    color  c1bTxtClr = useSuperTF ? C_LABEL_TXT : C_DIM_TXT
    table.cell(t, 0, 3, c1bLabel,        text_color = c1bTxtClr, text_size = TS,    bgcolor = c1bRowBg, text_halign = text.align_left)
    table.cell(t, 1, 3, c1bDesc,         text_color = c1bTxtClr, text_size = TS,    bgcolor = c1bRowBg)
    table.cell(t, 2, 3, c1bMode,         text_color = C_DIM_TXT, text_size = TS_SM, bgcolor = c1bRowBg)
    table.cell(t, 3, 3, useSuperTF ? f_badge(c1_superTF) : "—",
         text_color = useSuperTF ? f_badgeTxt(c1_superTF) : C_DIM_TXT,
         text_size = TS, bgcolor = useSuperTF ? f_badgeBg(c1_superTF) : c1bRowBg)

    // Fila 4 — C2 Pullback+
    string c2TrendStr = str.tostring(barsAboveEma) + "/" + str.tostring(c2TrendBars) + " barras OK"
    string c2Val      = c2_priorTrend ? c2TrendStr + "  Low " + str.tostring(low, "#.##") : c2TrendStr + " (sin tendencia previa)"
    table.cell(t, 0, 4, "C2 Dip+",      text_color = C_LABEL_TXT, text_size = TS,    bgcolor = C_ROW_BG, text_halign = text.align_left)
    table.cell(t, 1, 4, "Trend " + str.tostring(c2TrendBars) + "b + Low<=EMA" + str.tostring(emaFastLen), text_color = C_LABEL_TXT, text_size = TS, bgcolor = C_ROW_BG)
    table.cell(t, 2, 4, c2Val,          text_color = c2_priorTrend ? C_VALUE_TXT : color.new(#dc2626, 0), text_size = TS_SM, bgcolor = C_ROW_BG)
    table.cell(t, 3, 4, f_badge(c2_dip), text_color = f_badgeTxt(c2_dip), text_size = TS, bgcolor = f_badgeBg(c2_dip))

    // Fila 5 — C3 RSI
    string c3Val = "RSI " + str.tostring(rsiVal, "#.#") + "  RSI2 " + str.tostring(rsi2Val, "#.#")
    table.cell(t, 0, 5, "C3 RSI",       text_color = C_LABEL_TXT, text_size = TS,    bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
    table.cell(t, 1, 5, "RSI<" + str.tostring(rsiOB) + " | RSI2<" + str.tostring(rsi2OB, "#"), text_color = C_LABEL_TXT, text_size = TS, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 2, 5, c3Val,          text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 3, 5, f_badge(c3_rsi), text_color = f_badgeTxt(c3_rsi), text_size = TS, bgcolor = f_badgeBg(c3_rsi))

    // Fila 6 — C4 RVOL
    string c4Val = str.tostring(rvolRatio, "#.##") + "x avg"
    table.cell(t, 0, 6, "C4 RVOL",      text_color = C_LABEL_TXT, text_size = TS,    bgcolor = C_ROW_BG, text_halign = text.align_left)
    table.cell(t, 1, 6, "Vol > " + str.tostring(rvolMult, "#.#") + "x avg", text_color = C_LABEL_TXT, text_size = TS, bgcolor = C_ROW_BG)
    table.cell(t, 2, 6, c4Val,          text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_BG)
    table.cell(t, 3, 6, f_badge(c4_rvol), text_color = f_badgeTxt(c4_rvol), text_size = TS, bgcolor = f_badgeBg(c4_rvol))

    // Fila 7 — C5 Hammer
    string c5Val = "Wick " + str.tostring(lowerW / math.max(body, 0.0001), "#.#") + "x body"
    table.cell(t, 0, 7, "C5 Hammer",    text_color = C_LABEL_TXT, text_size = TS,    bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
    table.cell(t, 1, 7, "Wick >= 2x Body", text_color = C_LABEL_TXT, text_size = TS, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 2, 7, c5Val,          text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 3, 7, f_badge(c5_candle), text_color = f_badgeTxt(c5_candle), text_size = TS, bgcolor = f_badgeBg(c5_candle))

    // Fila 8 — C6 Tendencia
    string c6Label  = c6Required ? "C6 Tendencia*" : "C6 Tendencia"
    string c6Checks = (c6a_above50 ? "OK" : "X") + ">50  " + (c6b_above200 ? "OK" : "X") + ">200  GX:" + (c6c_golden ? "OK" : "X")
    string c6Val    = "D50 " + str.tostring(distSma50, "+#.#;-#.#") + "%  D200 " + str.tostring(distSma200, "+#.#;-#.#") + "%"
    table.cell(t, 0, 8, c6Label,        text_color = C_LABEL_TXT, text_size = TS,    bgcolor = C_C6_BG, text_halign = text.align_left)
    table.cell(t, 1, 8, c6Checks,       text_color = c6_trend ? color.new(#15803d, 0) : color.new(#dc2626, 0), text_size = TS_SM, bgcolor = C_C6_BG)
    table.cell(t, 2, 8, c6Val,          text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_C6_BG)
    table.cell(t, 3, 8, f_badge(c6_trend), text_color = f_badgeTxt(c6_trend), text_size = TS, bgcolor = f_badgeBg(c6_trend))

    // Fila 9 — C7 Divergencia RSI
    string c7Label  = not useC7 ? "C7 Div RSI" : c7Required ? "C7 Div RSI*" : "C7 Div RSI"
    string c7Checks = not useC7 ? "Desactivado" : (c7_priceLL ? "LL OK" : "LL X") + "  " + (c7_rsiHL ? "HL OK" : "HL X")
    string c7ValStr = not useC7 ? "—" : "RSIdiff " + str.tostring(c7RsiDiff, "+#.#;-#.#") + "  LB:" + str.tostring(c7Lookback) + "b"
    color  c7RowBg  = useC7 ? C_C7_BG : C_ROW_ALT_BG
    color  c7TxtClr = useC7 ? C_LABEL_TXT : C_DIM_TXT
    table.cell(t, 0, 9, c7Label,        text_color = c7TxtClr, text_size = TS,    bgcolor = c7RowBg, text_halign = text.align_left)
    table.cell(t, 1, 9, c7Checks,       text_color = useC7 ? (c7_divRaw ? color.new(#15803d, 0) : color.new(#dc2626, 0)) : C_DIM_TXT, text_size = TS_SM, bgcolor = c7RowBg)
    table.cell(t, 2, 9, c7ValStr,       text_color = useC7 ? C_VALUE_TXT : C_DIM_TXT, text_size = TS_SM, bgcolor = c7RowBg)
    table.cell(t, 3, 9, useC7 ? f_badge(c7_div) : "—",
         text_color = useC7 ? f_badgeTxt(c7_div) : C_DIM_TXT,
         text_size = TS, bgcolor = useC7 ? f_badgeBg(c7_div) : c7RowBg)

    // Fila 10 — Score + SL
    color  scoreBg    = fullSignal ? C_READY_BG : partialSignal ? C_WARN_BG : C_ROW_ALT_BG
    color  scoreTxt   = fullSignal ? C_READY_TXT : partialSignal ? C_WARN_TXT : C_LABEL_TXT
    string slStr      = "SL " + str.tostring(slLevel, "#.##") + "  (-" + str.tostring(slPct, "#.#") + "%)"
    table.cell(t, 0, 10, "SCORE",       text_color = scoreTxt, text_size = TS,    bgcolor = scoreBg)
    table.cell(t, 1, 10, str.tostring(score) + "/" + str.tostring(scoreMax) + " tecnicas", text_color = scoreTxt, text_size = TS, bgcolor = scoreBg)
    table.cell(t, 2, 10, slStr,         text_color = color.new(#991b1b, 0), text_size = TS_SM, bgcolor = scoreBg)
    table.cell(t, 3, 10, "",            bgcolor = scoreBg)

    // Fila 11 — Resultado final
    string resultTxt  = fullSignal ? "READY (" + str.tostring(score) + "/" + str.tostring(scoreMax) + ")" : partialSignal ? "WATCH (" + str.tostring(score) + "/" + str.tostring(scoreMax) + ")" : "NOT READY (" + str.tostring(score) + "/" + str.tostring(scoreMax) + ")"
    color  resultBg   = fullSignal ? C_READY_BG : partialSignal ? C_WARN_BG : C_NOTREADY_BG
    color  resultTxtC = fullSignal ? C_READY_TXT : partialSignal ? C_WARN_TXT : C_NOTREADY_TXT
    table.merge_cells(t, 0, 11, 3, 11)
    table.cell(t, 0, 11, resultTxt,     text_color = resultTxtC, text_size = TS, bgcolor = resultBg)

    // Fila 12 — Config activa
    string cfgStr = "C2:" + str.tostring(c2TrendBars) + "b  C6:" + (c6Required ? "OBLIG" : "punt") + "  TFsup:" + (useSuperTF ? (superTFRequired ? "OBLIG" : "punt") : "OFF") + "  C7:" + (not useC7 ? "OFF" : c7Required ? "OBLIG" : "punt") + " " + str.tostring(c7Lookback) + "b"
    table.merge_cells(t, 0, 12, 3, 12)
    table.cell(t, 0, 12, cfgStr,        text_color = color.new(#6b7280, 0), text_size = TS_SM, bgcolor = C_ROW_ALT_BG)

    // Fila 13 — Versión
    string verStr = "Ovtlier Plan A v5.1  " + str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00")
    table.merge_cells(t, 0, 13, 3, 13)
    table.cell(t, 0, 13, verStr,        text_color = C_DIM_TXT, text_size = TS_SM, bgcolor = C_HEADER_BG)

// ─── ALERTAS (sin cambios vs v5) ──────────────────────────────
string alertBase = syminfo.ticker + " | TF: " + timeframe.period +
     " | Close: "  + str.tostring(close, "#.##") +
     " | SL: "     + str.tostring(slLevel, "#.##") +
     " | SL%: -"   + str.tostring(slPct, "#.#") + "%" +
     " | Score: "  + str.tostring(score) + "/" + str.tostring(scoreMax) +
     " | C2bars: " + str.tostring(barsAboveEma) + "/" + str.tostring(c2TrendBars) +
     " | C6: "     + (c6_trend ? "OK" : "FAIL") +
     " | TFsup: "  + (useSuperTF ? (c1_superTF ? "OK" : "FAIL") : "OFF") +
     " | C7div: "  + (useC7 ? (c7_div ? "OK" : "FAIL") : "OFF")

if fullSignal
    alert("PLAN A READY | " + alertBase, alert.freq_once_per_bar_close)

if partialSignal
    alert("PLAN A WATCH | " + alertBase, alert.freq_once_per_bar_close)

alertcondition(fullSignal,    title = "Plan A - Senial Completa", message = "Plan A READY: senial completa. Revisa el grafico.")
alertcondition(partialSignal, title = "Plan A - Senial Parcial",  message = "Plan A WATCH: score parcial. Modo vigilancia.")
