// ═══════════════════════════════════════════════════════════════
// © Ovtlier University | Plan A Swing Indicator v1
// Basado en la metodología de Christopher Uhl
// Temporalidades: Daily (D) y Weekly (W)
// ═══════════════════════════════════════════════════════════════
//@version=6
indicator("Ovtlier Plan A - Swing v1", overlay = true, max_bars_back = 500)

// ─── INPUTS ───────────────────────────────────────────────────

// 📊 Parámetros de régimen (Condición 1)
spyEmaLen  = input.int(20,  "EMA Régimen SPY",  group = "📊 Régimen de Mercado", minval = 5)
qqqEmaLen  = input.int(20,  "EMA Régimen QQQ",  group = "📊 Régimen de Mercado", minval = 5)

// 📊 Parámetros técnicos del activo (Condiciones 2-5)
emaFastLen = input.int(9,   "EMA Rápida",       group = "📊 Parámetros Técnicos", minval = 3)
emaSlowLen = input.int(21,  "EMA Lenta",        group = "📊 Parámetros Técnicos", minval = 5)
rsiLen     = input.int(14,  "RSI Longitud",     group = "📊 Parámetros Técnicos", minval = 2)
rsiOB      = input.int(40,  "RSI Sobreventa",   group = "📊 Parámetros Técnicos", minval = 10, maxval = 50)
rsi2Len    = input.int(2,   "RSI-2 Longitud",   group = "📊 Parámetros Técnicos", minval = 1)
rsi2OB     = input.float(10.0,"RSI-2 Umbral",   group = "📊 Parámetros Técnicos", minval = 1.0, maxval = 30.0)
rvolMult   = input.float(1.5, "RVOL Multiplicador", group = "📊 Parámetros Técnicos", minval = 1.0, step = 0.1)
rvolLen    = input.int(20,  "RVOL Longitud",    group = "📊 Parámetros Técnicos", minval = 5)

// ⚠️ Risk
atrLen     = input.int(14,  "ATR Longitud",     group = "⚠️ Risk Management", minval = 1)
atrSlMult  = input.float(1.5,"ATR Stop-Loss x", group = "⚠️ Risk Management", minval = 0.5, step = 0.1)

// 🎨 Visualización
showRegime = input.bool(true, "Mostrar fondo régimen",  group = "🎨 Visual")
showTable  = input.bool(true, "Mostrar tabla scoring",  group = "🎨 Visual")
showSL     = input.bool(true, "Mostrar Stop-Loss",      group = "🎨 Visual")

// ─── CONDICIÓN 1: RÉGIMEN BROAD MARKET (SPY + QQQ) ───────────
// Ambos índices deben cerrar POR ENCIMA de su EMA(20) en la barra confirmada.
// Usamos [1] + lookahead_on para evitar repainting.

[spyClose, spyEma] = request.security("AMEX:SPY", timeframe.period,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqClose, qqqEma] = request.security("NASDAQ:QQQ", timeframe.period,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBull   = spyClose > spyEma   // SPY sobre su EMA → régimen alcista
bool qqqBull   = qqqClose > qqqEma   // QQQ sobre su EMA → régimen alcista
bool c1_regime = spyBull and qqqBull // AMBOS deben ser true

// ─── CONDICIÓN 2: PULLBACK A ZONA DE VALOR ───────────────────
// El precio ha tocado o cruzado la EMA rápida o lenta (zona de soporte dinámico).
// En Plan A esto representa el "buy the dip" al soporte institucional.

float emaFast  = ta.ema(close, emaFastLen)
float emaSlow  = ta.ema(close, emaSlowLen)

// Precio toca o entra en la zona entre EMA9 y EMA21
bool  c2_dip   = low <= emaFast and close >= emaSlow * 0.98
// Nota: 0.98 permite un mínimo de cierre ligeramente por debajo sin romper

// ─── CONDICIÓN 3: SOBREVENTA RELATIVA (RSI-14 + RSI-2) ───────
// RSI(14) < 40 O RSI(2) < 10: el activo está "frío" sin romperse.
// La idea de Uhl: comprar debilidad temporal en tendencia alcista.

float rsiVal   = ta.rsi(close, rsiLen)
float rsi2Val  = ta.rsi(close, rsi2Len)
bool  c3_rsi   = rsiVal < rsiOB or rsi2Val < rsi2OB

// ─── CONDICIÓN 4: RVOL ELEVADO ────────────────────────────────
// Volumen actual > multiplicador × media de los últimos N días.
// Indica interés institucional en la zona de soporte.

float avgVol   = ta.sma(volume, rvolLen)
bool  c4_rvol  = volume > rvolMult * avgVol

// ─── CONDICIÓN 5: VELA DE REVERSIÓN (HAMMER) ─────────────────
// Lower wick > 2× el cuerpo → rechazo fuerte del nivel inferior.
// Señal de que los compradores han absorbido la oferta.

float body     = math.abs(close - open)
float lowerW   = open > close ? (open - low) : (close - low)  // mecha inferior
float upperW   = open > close ? (high - open) : (high - close) // mecha superior
// Hammer: mecha baja al menos el doble del cuerpo, mecha alta pequeña
bool  c5_candle = lowerW >= 2 * body and upperW <= body and body > 0

// ─── SCORING: CUÁNTAS CONDICIONES SE CUMPLEN ─────────────────
// Condición 1 es OBLIGATORIA (sin régimen, no hay trade).
// Las condiciones 2-5 puntúan de 0 a 4.

int score = (c2_dip ? 1 : 0) + (c3_rsi ? 1 : 0) + (c4_rvol ? 1 : 0) + (c5_candle ? 1 : 0)

// Señal completa: régimen OK + mínimo 3 de 4 condiciones técnicas
bool fullSignal    = c1_regime and score >= 3  // señal fuerte
bool partialSignal = c1_regime and score == 2  // señal de vigilancia

// ─── STOP LOSS SUGERIDO (ATR) ─────────────────────────────────
float atrVal  = ta.atr(atrLen)
float slLevel = low - atrSlMult * atrVal  // stop debajo del low + buffer ATR

// ─── VISUALIZACIÓN SOBRE EL GRÁFICO ──────────────────────────

// Fondo verde suave cuando el régimen es alcista
bgcolor(showRegime and c1_regime ? color.new(color.teal, 93) : na, title = "Fondo régimen alcista")

// Señales en el gráfico
plotshape(fullSignal,    "Plan A Signal",   shape.triangleup,   location.belowbar, color.new(color.teal,  0),  size = size.normal,  text = "A")
plotshape(partialSignal, "Plan A Watch",    shape.triangleup,   location.belowbar, color.new(color.yellow,0),  size = size.small,   text = "~A")

// EMAs del activo
plot(emaFast, "EMA Rápida",  color.new(color.blue,   0), 1)
plot(emaSlow, "EMA Lenta",   color.new(color.orange, 0), 2)

// Stop Loss sugerido (solo en señal completa)
var line slLine = na
if fullSignal
    if not na(slLine)
        line.delete(slLine)
    slLine := showSL ? line.new(bar_index, slLevel, bar_index + 5, slLevel, color = color.new(color.red, 30), width = 1, style = line.style_dashed) : na

// ─── TABLA DE SCORING ─────────────────────────────────────────
var table scoreTable = table.new(position.top_right, 3, 7, bgcolor = color.new(color.gray, 85), border_color = color.new(color.gray, 60), border_width = 1)

if showTable and barstate.islast
    // Cabecera
    table.cell(scoreTable, 0, 0, "PLAN A",    text_color = color.white, text_size = size.small, bgcolor = color.new(color.teal, 20))
    table.cell(scoreTable, 1, 0, "Estado",    text_color = color.white, text_size = size.small, bgcolor = color.new(color.teal, 20))
    table.cell(scoreTable, 2, 0, "OK?",       text_color = color.white, text_size = size.small, bgcolor = color.new(color.teal, 20))

    // Condición 1 — RÉGIMEN (obligatoria)
    table.cell(scoreTable, 0, 1, "C1 Régimen",    text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 1, 1, "SPY+QQQ>EMA",   text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 2, 1, c1_regime ? "✅" : "❌", text_color = c1_regime ? color.teal : color.red, text_size = size.tiny)

    // Condición 2 — PULLBACK
    table.cell(scoreTable, 0, 2, "C2 Dip",         text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 1, 2, "Low≤EMA9",        text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 2, 2, c2_dip ? "✅" : "—", text_color = c2_dip ? color.teal : color.gray, text_size = size.tiny)

    // Condición 3 — RSI
    table.cell(scoreTable, 0, 3, "C3 RSI",          text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 1, 3, "RSI<40|RSI2<10",  text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 2, 3, c3_rsi ? "✅" : "—", text_color = c3_rsi ? color.teal : color.gray, text_size = size.tiny)

    // Condición 4 — RVOL
    table.cell(scoreTable, 0, 4, "C4 RVOL",         text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 1, 4, "Vol>1.5x avg",    text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 2, 4, c4_rvol ? "✅" : "—", text_color = c4_rvol ? color.teal : color.gray, text_size = size.tiny)

    // Condición 5 — VELA
    table.cell(scoreTable, 0, 5, "C5 Vela",         text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 1, 5, "Hammer",           text_color = color.silver, text_size = size.tiny)
    table.cell(scoreTable, 2, 5, c5_candle ? "✅" : "—", text_color = c5_candle ? color.teal : color.gray, text_size = size.tiny)

    // Score total
    string scoreLabel = str.tostring(score) + "/4"
    color  scoreBg    = fullSignal ? color.new(color.teal, 20) : partialSignal ? color.new(color.orange, 20) : color.new(color.gray, 60)
    string scoreText  = fullSignal ? "🟢 " + scoreLabel : partialSignal ? "🟡 " + scoreLabel : "⚪ " + scoreLabel
    table.cell(scoreTable, 0, 6, "SCORE",        text_color = color.white, text_size = size.small, bgcolor = scoreBg)
    table.cell(scoreTable, 1, 6, scoreText,      text_color = color.white, text_size = size.small, bgcolor = scoreBg)
    table.cell(scoreTable, 2, 6, c1_regime ? (fullSignal ? "LONG" : "WATCH") : "NO GO", text_color = color.white, text_size = size.small, bgcolor = scoreBg)

// ─── ALERTAS ──────────────────────────────────────────────────

// alert() para mensajes dinámicos (con ticker, precio, score)
string alertBase = syminfo.ticker + " | TF: " + timeframe.period + " | Close: " + str.tostring(close, "#.##") + " | SL: " + str.tostring(slLevel, "#.##") + " | Score: " + str.tostring(score) + "/4"

if fullSignal
    alert("🟢 PLAN A SEÑAL | " + alertBase, alert.freq_once_per_bar_close)

if partialSignal
    alert("🟡 PLAN A VIGILAR | " + alertBase, alert.freq_once_per_bar_close)

// alertcondition() para el panel de alertas de TradingView (solo const string)
alertcondition(fullSignal,    title = "Plan A - Señal Completa",  message = "Plan A: Señal completa detectada. Revisa el gráfico.")
alertcondition(partialSignal, title = "Plan A - Señal Parcial",   message = "Plan A: 2/4 condiciones. Modo vigilancia.")
