// ═══════════════════════════════════════════════════════════════
// © Ovtlier University | Plan A Swing Indicator v4
// Basado en la metodología de Christopher Uhl
// Temporalidades: Daily (D) y Weekly (W)
// v4: C2 mejorada — ventana de tendencia previa configurable
//     C1 doble timeframe — régimen confirmado en TF superior
// ═══════════════════════════════════════════════════════════════
//@version=6
indicator("Ovtlier Plan A - Swing v4", overlay = true, max_bars_back = 500)

// ─── INPUTS ───────────────────────────────────────────────────

// 📊 Régimen de Mercado — C1
spyEmaLen      = input.int(20,  "EMA Régimen SPY",            group = "📊 Régimen de Mercado C1", minval = 5)
qqqEmaLen      = input.int(20,  "EMA Régimen QQQ",            group = "📊 Régimen de Mercado C1", minval = 5)
useSuperTF     = input.bool(false, "Activar doble TF (C1 superior)", group = "📊 Régimen de Mercado C1",
     tooltip = "ON: verifica que SPY+QQQ también están en régimen alcista en el TF superior.\nDaily -> confirma en Weekly. Weekly -> confirma en Monthly.")
superTFRequired = input.bool(false, "TF superior obligatorio",  group = "📊 Régimen de Mercado C1",
     tooltip = "ON: si el TF superior falla, no hay señal aunque C1 base pase.\nOFF: el TF superior suma 1 punto al score técnico.")

// 📊 Parámetros Técnicos
emaFastLen     = input.int(9,   "EMA Rápida",                 group = "📊 Parámetros Técnicos", minval = 3)
emaSlowLen     = input.int(21,  "EMA Lenta",                  group = "📊 Parámetros Técnicos", minval = 5)
rsiLen         = input.int(14,  "RSI Longitud",               group = "📊 Parámetros Técnicos", minval = 2)
rsiOB          = input.int(40,  "RSI Umbral Sobreventa",      group = "📊 Parámetros Técnicos", minval = 10, maxval = 50)
rsi2Len        = input.int(2,   "RSI-2 Longitud",             group = "📊 Parámetros Técnicos", minval = 1)
rsi2OB         = input.float(10.0, "RSI-2 Umbral",            group = "📊 Parámetros Técnicos", minval = 1.0, maxval = 30.0)
rvolMult       = input.float(1.5,  "RVOL Multiplicador",      group = "📊 Parámetros Técnicos", minval = 1.0, step = 0.1)
rvolLen        = input.int(20,  "RVOL Longitud",              group = "📊 Parámetros Técnicos", minval = 5)

// 🎯 C2 Pullback mejorado
c2TrendBars    = input.int(3,   "C2 Barras tendencia previa", group = "🎯 C2 Pullback Mejorado", minval = 1, maxval = 10,
     tooltip = "Número de barras anteriores que deben haber cerrado por encima de la EMA rápida antes del pullback actual.\nDefault 3. Rango: 1-10.")

// 📈 Filtro de Tendencia del Activo — C6
sma50Len       = input.int(50,  "SMA Media (defecto 50)",     group = "📈 Filtro Tendencia C6", minval = 10)
sma200Len      = input.int(200, "SMA Larga (defecto 200)",    group = "📈 Filtro Tendencia C6", minval = 50)
c6Required     = input.bool(false, "C6 obligatoria (además de C1)", group = "📈 Filtro Tendencia C6",
     tooltip = "ON: sin tendencia alcista del activo no hay señal aunque C1 pase.\nOFF: C6 suma al score como el resto de condiciones técnicas.")

// ⚠️ Risk Management
atrLen         = input.int(14,  "ATR Longitud",               group = "⚠️ Risk Management", minval = 1)
atrSlMult      = input.float(1.5, "ATR Stop-Loss x",          group = "⚠️ Risk Management", minval = 0.5, step = 0.1)

// 🎨 Visual
showRegime     = input.bool(true,  "Mostrar fondo régimen",   group = "🎨 Visual")
showTable      = input.bool(true,  "Mostrar tabla scoring",   group = "🎨 Visual")
showSL         = input.bool(true,  "Mostrar Stop-Loss",       group = "🎨 Visual")
tablePosInput  = input.string("Top Right", "Posicion tabla",
     options = ["Top Right", "Top Left", "Top Center", "Bottom Right", "Bottom Left", "Bottom Center", "Middle Right", "Middle Left"],
     group = "🎨 Visual")

// ─── POSICIÓN DE TABLA ────────────────────────────────────────
tablePos = switch tablePosInput
    "Top Right"     => position.top_right
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Middle Right"  => position.middle_right
    "Middle Left"   => position.middle_left
    => position.top_right

// ─── PALETA DE COLORES ────────────────────────────────────────
color C_HEADER_BG   = color.new(#1a2433, 0)
color C_HEADER_TXT  = color.white
color C_ROW_BG      = color.new(#0d1117, 0)
color C_ROW_ALT_BG  = color.new(#141c26, 0)
color C_LABEL_TXT   = color.new(#c9d1d9, 0)
color C_VALUE_TXT   = color.new(#58a6ff, 0)
color C_PASS_BG     = color.new(#1a6b3c, 0)
color C_PASS_TXT    = color.white
color C_FAIL_BG     = color.new(#8b1a1a, 0)
color C_FAIL_TXT    = color.white
color C_WARN_BG     = color.new(#7a5c00, 0)
color C_READY_BG    = color.new(#0d5c2e, 0)
color C_NOTREADY_BG = color.new(#6b0f0f, 0)
color C_TICKER_BG   = color.new(#0f1923, 0)
color C_TICKER_TXT  = color.new(#58a6ff, 0)
color C_OBLIG_BG    = color.new(#1a2d1a, 0)
color C_C6_BG       = color.new(#1a1f2d, 0)
color C_STF_BG      = color.new(#1f1a2d, 0)   // púrpura muy oscuro — fila TF superior

// ─── HELPERS ─────────────────────────────────────────────────
// Resuelve el TF superior según el TF actual del gráfico
f_superTF() =>
    if timeframe.isweekly or timeframe.ismonthly
        "M"
    else
        "W"   // Daily -> Weekly por defecto

// ─── CONDICIÓN 1: RÉGIMEN BROAD MARKET (SPY + QQQ) ───────────
// Anti-repainting: close[1] + lookahead_on

[spyClose, spyEma] = request.security("AMEX:SPY", timeframe.period,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqClose, qqqEma] = request.security("NASDAQ:QQQ", timeframe.period,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBull   = spyClose > spyEma
bool qqqBull   = qqqClose > qqqEma
bool c1_regime = spyBull and qqqBull

// ─── C1 DOBLE TIMEFRAME (TF SUPERIOR) ────────────────────────
// Verifica el mismo check SPY+QQQ en el TF superior al del gráfico.
// Solo activo cuando useSuperTF = true.
// Anti-repainting igual que C1 base.

string superTF = f_superTF()

[spyCloseSup, spyEmaSup] = request.security("AMEX:SPY", superTF,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqCloseSup, qqqEmaSup] = request.security("NASDAQ:QQQ", superTF,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBullSup  = spyCloseSup > spyEmaSup
bool qqqBullSup  = qqqCloseSup > qqqEmaSup
bool c1_superTF  = spyBullSup and qqqBullSup   // régimen en TF superior

// Gate del TF superior: solo aplica si useSuperTF está ON
bool superTFGate = not useSuperTF or (superTFRequired ? c1_superTF : true)

// ─── CONDICIÓN 2: PULLBACK CON CONTEXTO DE TENDENCIA ─────────
// MEJORADO en v4: el precio debe haber estado N barras consecutivas
// por encima de la EMA rápida antes del toque actual.
// Esto filtra pullbacks en rangos laterales donde no hay tendencia previa.

float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)

// Cuenta cuántas de las últimas N barras cerraron sobre la EMA rápida
int barsAboveEma = 0
for i = 1 to c2TrendBars
    if close[i] > emaFast[i]
        barsAboveEma += 1

// C2 pasa si: todas N barras previas sobre EMA (tendencia previa confirmada)
// Y el low actual toca la EMA (pullback real) con cierre no rompiendo EMA lenta
bool c2_priorTrend = barsAboveEma >= c2TrendBars
bool c2_touchEma   = low <= emaFast and close >= emaSlow * 0.98
bool c2_dip        = c2_priorTrend and c2_touchEma

// ─── CONDICIÓN 3: SOBREVENTA RELATIVA ────────────────────────
float rsiVal  = ta.rsi(close, rsiLen)
float rsi2Val = ta.rsi(close, rsi2Len)
bool  c3_rsi  = rsiVal < rsiOB or rsi2Val < rsi2OB

// ─── CONDICIÓN 4: RVOL ELEVADO ────────────────────────────────
float avgVol    = ta.sma(volume, rvolLen)
float rvolRatio = volume / avgVol
bool  c4_rvol   = rvolRatio > rvolMult

// ─── CONDICIÓN 5: VELA DE REVERSIÓN (HAMMER) ─────────────────
float body    = math.abs(close - open)
float lowerW  = open > close ? (open - low)  : (close - low)
float upperW  = open > close ? (high - open) : (high - close)
bool  c5_candle = lowerW >= 2.0 * body and upperW <= body and body > 0.0

// ─── CONDICIÓN 6: TENDENCIA DEL ACTIVO (SMA 50/200) ──────────
float sma50  = ta.sma(close, sma50Len)
float sma200 = ta.sma(close, sma200Len)

bool c6a_above50  = close > sma50
bool c6b_above200 = close > sma200
bool c6c_golden   = sma50 > sma200
bool c6_trend     = c6a_above50 and c6b_above200 and c6c_golden

float distSma50  = (close - sma50)  / sma50  * 100
float distSma200 = (close - sma200) / sma200 * 100

// ─── SCORING ──────────────────────────────────────────────────
// Condiciones obligatorias: C1 siempre. C6 y TF superior si sus inputs lo dictan.
// Score técnico base: C2-C6 = 0 a 5 puntos.
// TF superior en modo puntuado: suma 1 punto adicional (max 6).

int scoreBase = (c2_dip ? 1 : 0) + (c3_rsi ? 1 : 0) + (c4_rvol ? 1 : 0) + (c5_candle ? 1 : 0) + (c6_trend ? 1 : 0)
int scoreSuperTF = (useSuperTF and not superTFRequired and c1_superTF) ? 1 : 0
int score     = scoreBase + scoreSuperTF
int scoreMax  = useSuperTF and not superTFRequired ? 6 : 5

bool c6Gate      = c6Required ? c6_trend : true
bool fullSignal  = c1_regime and superTFGate and c6Gate and score >= (scoreMax - 1)
bool partialSignal = c1_regime and superTFGate and c6Gate and score == (scoreMax - 2)

// ─── STOP LOSS SUGERIDO ───────────────────────────────────────
float atrVal  = ta.atr(atrLen)
float slLevel = low - atrSlMult * atrVal
float slPct   = (close - slLevel) / close * 100

// ─── PLOTS ────────────────────────────────────────────────────
bgcolor(showRegime and c1_regime ? color.new(color.teal, 93) : na, title = "Fondo regimen")

plotshape(fullSignal,    "Plan A Signal", shape.triangleup, location.belowbar, color.new(color.teal,   0), size = size.normal, text = "A")
plotshape(partialSignal, "Plan A Watch",  shape.triangleup, location.belowbar, color.new(color.yellow, 0), size = size.small,  text = "~A")

plot(emaFast, "EMA Rapida", color.new(color.blue,   0), 1)
plot(emaSlow, "EMA Lenta",  color.new(color.orange, 0), 2)
plot(sma50,   "SMA 50",     color.new(color.purple, 0), 1)
plot(sma200,  "SMA 200",    color.new(color.yellow, 0), 2)

var line slLine = na
if fullSignal
    if not na(slLine)
        line.delete(slLine)
    slLine := showSL ? line.new(bar_index, slLevel, bar_index + 5, slLevel,
         color = color.new(color.red, 20), width = 1, style = line.style_dashed) : na

// ─── HELPERS TABLA ────────────────────────────────────────────
f_badge(bool cond)    => cond ? "OK  PASS" : "X   FAIL"
f_badgeBg(bool cond)  => cond ? C_PASS_BG  : C_FAIL_BG
f_badgeTxt(bool cond) => cond ? C_PASS_TXT : C_FAIL_TXT

// ─── TABLA — 4 columnas x 13 filas ───────────────────────────
// Fila extra para TF superior (C1b) cuando useSuperTF = ON

var table t = table.new(tablePos, 4, 13,
     border_color = color.new(color.black, 0), border_width = 1,
     frame_color  = color.new(color.black, 0), frame_width  = 2)

if showTable and barstate.islast

    // Fila 0 — Cabecera
    table.cell(t, 0, 0, "OVTLIER PLAN A", text_color = C_HEADER_TXT, text_size = size.small, bgcolor = C_HEADER_BG, text_halign = text.align_left)
    table.cell(t, 1, 0, "CONDICION",      text_color = C_HEADER_TXT, text_size = size.small, bgcolor = C_HEADER_BG)
    table.cell(t, 2, 0, "VALOR",          text_color = C_HEADER_TXT, text_size = size.small, bgcolor = C_HEADER_BG)
    table.cell(t, 3, 0, "STATUS",         text_color = C_HEADER_TXT, text_size = size.small, bgcolor = C_HEADER_BG)

    // Fila 1 — Ticker + TF
    table.cell(t, 0, 1, syminfo.ticker,   text_color = C_TICKER_TXT, text_size = size.small, bgcolor = C_TICKER_BG, text_halign = text.align_left)
    table.cell(t, 1, 1, "TF: " + timeframe.period, text_color = C_TICKER_TXT, text_size = size.small, bgcolor = C_TICKER_BG)
    table.cell(t, 2, 1, "SPY " + (spyBull ? "OK" : "X") + "  QQQ " + (qqqBull ? "OK" : "X"),
         text_color = c1_regime ? color.new(#4caf50, 0) : color.new(#f44336, 0), text_size = size.tiny, bgcolor = C_TICKER_BG)
    table.cell(t, 3, 1, "", bgcolor = C_TICKER_BG)

    // Fila 2 — C1 Régimen base (obligatoria)
    table.cell(t, 0, 2, "C1 Regimen",     text_color = C_LABEL_TXT,  text_size = size.small, bgcolor = C_OBLIG_BG, text_halign = text.align_left)
    table.cell(t, 1, 2, "SPY+QQQ > EMA " + str.tostring(spyEmaLen), text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_OBLIG_BG)
    table.cell(t, 2, 2, "OBLIGATORIA",    text_color = color.new(#c9d1d9, 50), text_size = size.tiny, bgcolor = C_OBLIG_BG)
    table.cell(t, 3, 2, f_badge(c1_regime), text_color = f_badgeTxt(c1_regime), text_size = size.small, bgcolor = f_badgeBg(c1_regime))

    // Fila 3 — C1b TF Superior (solo visible si useSuperTF ON)
    string c1bLabel = useSuperTF ? "C1b TF " + superTF : "C1b TF sup"
    string c1bDesc  = useSuperTF ? "SPY+QQQ > EMA en " + superTF : "Desactivado"
    string c1bMode  = useSuperTF ? (superTFRequired ? "OBLIGATORIA" : "PUNTUADA +1") : "OFF"
    string c1bVal   = useSuperTF ? "SPY " + (spyBullSup ? "OK" : "X") + "  QQQ " + (qqqBullSup ? "OK" : "X") : "—"
    color  c1bRowBg = useSuperTF ? C_STF_BG : color.new(#0d1117, 60)
    color  c1bTxtClr = useSuperTF ? C_LABEL_TXT : color.new(#c9d1d9, 70)
    table.cell(t, 0, 3, c1bLabel,         text_color = c1bTxtClr, text_size = size.small, bgcolor = c1bRowBg, text_halign = text.align_left)
    table.cell(t, 1, 3, c1bDesc,          text_color = c1bTxtClr, text_size = size.small, bgcolor = c1bRowBg)
    table.cell(t, 2, 3, c1bMode,          text_color = color.new(#c9d1d9, 50), text_size = size.tiny, bgcolor = c1bRowBg)
    table.cell(t, 3, 3, useSuperTF ? f_badge(c1_superTF) : "—",
         text_color = useSuperTF ? f_badgeTxt(c1_superTF) : color.new(#c9d1d9, 70),
         text_size = size.small,
         bgcolor = useSuperTF ? f_badgeBg(c1_superTF) : c1bRowBg)

    // Fila 4 — C2 Pullback mejorado
    string c2TrendStr = str.tostring(barsAboveEma) + "/" + str.tostring(c2TrendBars) + " barras OK"
    string c2Val      = c2_priorTrend ? c2TrendStr + "  Low " + str.tostring(low, "#.##") : c2TrendStr + " (sin tendencia previa)"
    table.cell(t, 0, 4, "C2 Dip+",       text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_BG, text_halign = text.align_left)
    table.cell(t, 1, 4, "Trend " + str.tostring(c2TrendBars) + "b + Low<=EMA" + str.tostring(emaFastLen), text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_BG)
    table.cell(t, 2, 4, c2Val,           text_color = c2_priorTrend ? C_VALUE_TXT : color.new(#f44336, 40), text_size = size.tiny, bgcolor = C_ROW_BG)
    table.cell(t, 3, 4, f_badge(c2_dip), text_color = f_badgeTxt(c2_dip), text_size = size.small, bgcolor = f_badgeBg(c2_dip))

    // Fila 5 — C3 RSI
    string c3Val = "RSI " + str.tostring(rsiVal, "#.#") + "  RSI2 " + str.tostring(rsi2Val, "#.#")
    table.cell(t, 0, 5, "C3 RSI",        text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
    table.cell(t, 1, 5, "RSI<" + str.tostring(rsiOB) + " | RSI2<" + str.tostring(rsi2OB, "#"), text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 2, 5, c3Val,           text_color = C_VALUE_TXT, text_size = size.tiny,  bgcolor = C_ROW_ALT_BG)
    table.cell(t, 3, 5, f_badge(c3_rsi), text_color = f_badgeTxt(c3_rsi), text_size = size.small, bgcolor = f_badgeBg(c3_rsi))

    // Fila 6 — C4 RVOL
    string c4Val = str.tostring(rvolRatio, "#.##") + "x avg"
    table.cell(t, 0, 6, "C4 RVOL",       text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_BG, text_halign = text.align_left)
    table.cell(t, 1, 6, "Vol > " + str.tostring(rvolMult, "#.#") + "x avg", text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_BG)
    table.cell(t, 2, 6, c4Val,           text_color = C_VALUE_TXT, text_size = size.tiny,  bgcolor = C_ROW_BG)
    table.cell(t, 3, 6, f_badge(c4_rvol), text_color = f_badgeTxt(c4_rvol), text_size = size.small, bgcolor = f_badgeBg(c4_rvol))

    // Fila 7 — C5 Hammer
    string c5Val = "Wick " + str.tostring(lowerW / math.max(body, 0.0001), "#.#") + "x body"
    table.cell(t, 0, 7, "C5 Hammer",     text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
    table.cell(t, 1, 7, "Wick >= 2x Body", text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_ROW_ALT_BG)
    table.cell(t, 2, 7, c5Val,           text_color = C_VALUE_TXT, text_size = size.tiny,  bgcolor = C_ROW_ALT_BG)
    table.cell(t, 3, 7, f_badge(c5_candle), text_color = f_badgeTxt(c5_candle), text_size = size.small, bgcolor = f_badgeBg(c5_candle))

    // Fila 8 — C6 Tendencia
    string c6Label  = c6Required ? "C6 Tendencia*" : "C6 Tendencia"
    string c6Checks = (c6a_above50 ? "OK" : "X") + ">50  " + (c6b_above200 ? "OK" : "X") + ">200  GX:" + (c6c_golden ? "OK" : "X")
    string c6Val    = "D50 " + str.tostring(distSma50, "+#.#;-#.#") + "%  D200 " + str.tostring(distSma200, "+#.#;-#.#") + "%"
    table.cell(t, 0, 8, c6Label,         text_color = C_LABEL_TXT, text_size = size.small, bgcolor = C_C6_BG, text_halign = text.align_left)
    table.cell(t, 1, 8, c6Checks,        text_color = c6_trend ? color.new(#4caf50, 0) : color.new(#f44336, 0), text_size = size.tiny, bgcolor = C_C6_BG)
    table.cell(t, 2, 8, c6Val,           text_color = C_VALUE_TXT, text_size = size.tiny,  bgcolor = C_C6_BG)
    table.cell(t, 3, 8, f_badge(c6_trend), text_color = f_badgeTxt(c6_trend), text_size = size.small, bgcolor = f_badgeBg(c6_trend))

    // Fila 9 — Score + SL
    color  scoreBg = fullSignal ? C_READY_BG : partialSignal ? C_WARN_BG : color.new(#1a1a2e, 0)
    string slStr   = "SL " + str.tostring(slLevel, "#.##") + "  (-" + str.tostring(slPct, "#.#") + "%)"
    table.cell(t, 0, 9, "SCORE",         text_color = color.white, text_size = size.small, bgcolor = scoreBg)
    table.cell(t, 1, 9, str.tostring(score) + "/" + str.tostring(scoreMax) + " tecnicas", text_color = color.white, text_size = size.small, bgcolor = scoreBg)
    table.cell(t, 2, 9, slStr,           text_color = color.new(#ffcdd2, 0), text_size = size.tiny, bgcolor = scoreBg)
    table.cell(t, 3, 9, "",              bgcolor = scoreBg)

    // Fila 10 — Resultado final
    string resultTxt = fullSignal    ? "READY ("     + str.tostring(score) + "/" + str.tostring(scoreMax) + ")" :
                       partialSignal ? "WATCH ("     + str.tostring(score) + "/" + str.tostring(scoreMax) + ")" :
                                       "NOT READY (" + str.tostring(score) + "/" + str.tostring(scoreMax) + ")"
    color  resultBg  = fullSignal ? C_READY_BG : partialSignal ? C_WARN_BG : C_NOTREADY_BG
    table.merge_cells(t, 0, 10, 3, 10)
    table.cell(t, 0, 10, resultTxt,      text_color = color.white, text_size = size.normal, bgcolor = resultBg)

    // Fila 11 — Inputs activos (resumen rápido de configuración)
    string cfgStr = "C2:" + str.tostring(c2TrendBars) + "b  " +
         "C6:" + (c6Required ? "OBLIG" : "punt") + "  " +
         "TFsup:" + (useSuperTF ? (superTFRequired ? "OBLIG" : "punt") : "OFF")
    table.merge_cells(t, 0, 11, 3, 11)
    table.cell(t, 0, 11, cfgStr,         text_color = color.new(#58a6ff, 30), text_size = size.tiny, bgcolor = color.new(#0d1117, 0))

    // Fila 12 — Versión
    string verStr = "Ovtlier Plan A v4  " + str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00")
    table.merge_cells(t, 0, 12, 3, 12)
    table.cell(t, 0, 12, verStr,         text_color = color.new(#c9d1d9, 60), text_size = size.tiny, bgcolor = C_HEADER_BG)

// ─── ALERTAS ──────────────────────────────────────────────────
string alertBase = syminfo.ticker + " | TF: " + timeframe.period +
     " | Close: " + str.tostring(close, "#.##") +
     " | SL: "    + str.tostring(slLevel, "#.##") +
     " | SL%: -"  + str.tostring(slPct, "#.#") + "%" +
     " | Score: " + str.tostring(score) + "/" + str.tostring(scoreMax) +
     " | C2bars: " + str.tostring(barsAboveEma) + "/" + str.tostring(c2TrendBars) +
     " | C6: "    + (c6_trend ? "OK" : "FAIL") +
     " | TFsup: " + (useSuperTF ? (c1_superTF ? "OK" : "FAIL") : "OFF")

if fullSignal
    alert("PLAN A READY | " + alertBase, alert.freq_once_per_bar_close)

if partialSignal
    alert("PLAN A WATCH | " + alertBase, alert.freq_once_per_bar_close)

alertcondition(fullSignal,    title = "Plan A - Senial Completa", message = "Plan A READY: senial completa. Revisa el grafico.")
alertcondition(partialSignal, title = "Plan A - Senial Parcial",  message = "Plan A WATCH: score parcial. Modo vigilancia.")
