// ═══════════════════════════════════════════════════════════════
// © Ovtlier University | Plan A Screener v1
// Basado en la metodología de Christopher Uhl
// Escanea hasta 6 símbolos simultáneamente con las 7 condiciones
// completas del indicador Plan A v5.2.
//
// CASO DE ACEPTACIÓN: el score mostrado aquí debe coincidir
// EXACTAMENTE con el score del indicador Plan A v5.2 individual
// sobre el mismo símbolo en el mismo timeframe.
//
// DISEÑO DE LLAMADAS request.security():
//   - SPY + QQQ (C1 base):    2 llamadas globales
//   - SPY + QQQ (C1b TF sup): 2 llamadas globales (si activo)
//   - 6 símbolos × 1 tuple (OHLCV):  6 llamadas
//   TOTAL: máx. 10 de 40 permitidas
// ═══════════════════════════════════════════════════════════════
//@version=6
indicator("Ovtlier Plan A - Screener v1", overlay = false, max_bars_back = 500)

// ─── INPUTS — SÍMBOLOS ────────────────────────────────────────
sym1 = input.symbol("NASDAQ:AAPL", "Símbolo 1", group = "📋 Símbolos")
sym2 = input.symbol("NASDAQ:MSFT", "Símbolo 2", group = "📋 Símbolos")
sym3 = input.symbol("NASDAQ:NVDA", "Símbolo 3", group = "📋 Símbolos")
sym4 = input.symbol("NASDAQ:AMZN", "Símbolo 4", group = "📋 Símbolos")
sym5 = input.symbol("NASDAQ:TSLA", "Símbolo 5", group = "📋 Símbolos")
sym6 = input.symbol("NASDAQ:META", "Símbolo 6", group = "📋 Símbolos")

// ─── INPUTS — RÉGIMEN C1 ──────────────────────────────────────
spyEmaLen       = input.int(20,    "EMA Régimen SPY",             group = "📊 Régimen C1", minval = 5)
qqqEmaLen       = input.int(20,    "EMA Régimen QQQ",             group = "📊 Régimen C1", minval = 5)
useSuperTF      = input.bool(false, "Activar doble TF (C1 superior)", group = "📊 Régimen C1",
     tooltip = "Daily -> confirma en Weekly. Weekly -> confirma en Monthly.")
superTFRequired = input.bool(false, "TF superior obligatorio",    group = "📊 Régimen C1",
     tooltip = "ON: gate adicional. OFF: suma +1 al score.")

// ─── INPUTS — PARÁMETROS TÉCNICOS ─────────────────────────────
emaFastLen  = input.int(9,     "EMA Rápida",               group = "📊 Parámetros Técnicos", minval = 3)
emaSlowLen  = input.int(21,    "EMA Lenta",                group = "📊 Parámetros Técnicos", minval = 5)
rsiLen      = input.int(14,    "RSI Longitud",             group = "📊 Parámetros Técnicos", minval = 2)
rsiOB       = input.int(40,    "RSI Umbral Sobreventa",   group = "📊 Parámetros Técnicos", minval = 10, maxval = 50)
rsi2Len     = input.int(2,     "RSI-2 Longitud",           group = "📊 Parámetros Técnicos", minval = 1)
rsi2OB      = input.float(10.0,"RSI-2 Umbral",             group = "📊 Parámetros Técnicos", minval = 1.0, maxval = 30.0)
rvolMult    = input.float(1.5, "RVOL Multiplicador",       group = "📊 Parámetros Técnicos", minval = 1.0, step = 0.1)
rvolLen     = input.int(20,    "RVOL Longitud",            group = "📊 Parámetros Técnicos", minval = 5)
c2TrendBars = input.int(3,     "C2 Barras tendencia previa", group = "📊 Parámetros Técnicos", minval = 1, maxval = 10,
     tooltip = "Barras previas que deben cerrar sobre EMA rápida antes del pullback. Debe coincidir con el indicador Plan A.")
sma50Len    = input.int(50,    "SMA 50 Longitud",          group = "📊 Parámetros Técnicos", minval = 10)
sma200Len   = input.int(200,   "SMA 200 Longitud",         group = "📊 Parámetros Técnicos", minval = 50)
c6Required  = input.bool(false, "C6 obligatoria",          group = "📊 Parámetros Técnicos")
useC7       = input.bool(true,  "Activar C7 Divergencia",  group = "📊 Parámetros Técnicos")
c7Lookback  = input.int(5,     "C7 Ventana barras",        group = "📊 Parámetros Técnicos", minval = 2, maxval = 20)
c7Required  = input.bool(false, "C7 obligatoria",          group = "📊 Parámetros Técnicos")
atrLen      = input.int(14,    "ATR Longitud",             group = "📊 Parámetros Técnicos", minval = 1)
atrSlMult   = input.float(1.5, "ATR Stop-Loss x",          group = "📊 Parámetros Técnicos", minval = 0.5, step = 0.1)

// ─── INPUTS — VISUAL ──────────────────────────────────────────
tamPanelInput  = input.string("small", "Tamaño de texto",
     options = ["tiny", "small", "normal", "large"], group = "🎨 Visual")
tablePosInput  = input.string("Top Right", "Posicion tabla",
     options = ["Top Right", "Top Left", "Top Center", "Bottom Right", "Bottom Left", "Bottom Center", "Middle Right", "Middle Left"],
     group = "🎨 Visual")

// ─── TAMAÑO DE TEXTO ─────────────────────────────────────────
TS = switch tamPanelInput
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.small

TS_SM = switch tamPanelInput
    "tiny"   => size.tiny
    "small"  => size.tiny
    "normal" => size.small
    "large"  => size.small
    => size.tiny

// ─── POSICIÓN TABLA ───────────────────────────────────────────
tablePos = switch tablePosInput
    "Top Right"     => position.top_right
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Middle Right"  => position.middle_right
    "Middle Left"   => position.middle_left
    => position.top_right

// ─── PALETA CLARA — idéntica al indicador v5.2 ───────────────
color C_HEADER_BG    = color.new(#eef0f6, 0)
color C_HEADER_TXT   = color.new(#111827, 0)
color C_ROW_BG       = color.new(#ffffff, 0)
color C_ROW_ALT_BG   = color.new(#f4f5f8, 0)
color C_LABEL_TXT    = color.new(#0f1117, 0)
color C_VALUE_TXT    = color.new(#1f2937, 0)
color C_TICKER_TXT   = color.new(#1d4ed8, 0)
color C_PASS_BG      = color.new(#dcfce7, 0)
color C_PASS_TXT     = color.new(#14532d, 0)
color C_FAIL_BG      = color.new(#fee2e2, 0)
color C_FAIL_TXT     = color.new(#991b1b, 0)
color C_WARN_BG      = color.new(#fef3c7, 0)
color C_WARN_TXT     = color.new(#b45309, 0)
color C_READY_BG     = color.new(#bbf7d0, 0)
color C_READY_TXT    = color.new(#14532d, 0)
color C_NOTREADY_BG  = color.new(#fecaca, 0)
color C_NOTREADY_TXT = color.new(#991b1b, 0)
color C_DIM_TXT      = color.new(#9ca3af, 0)
color C_BORDER       = color.new(#d1d5db, 0)

// ─── HELPER: TF SUPERIOR ─────────────────────────────────────
f_superTF() =>
    if timeframe.isweekly or timeframe.ismonthly
        "M"
    else
        "W"

// ─── C1: RÉGIMEN BROAD MARKET — calculado UNA VEZ globalmente ─
// SPY y QQQ se evalúan sobre el TF del gráfico, no sobre cada símbolo.
// Misma lógica anti-repainting que el indicador v5.2.

[spyClose, spyEma] = request.security("AMEX:SPY", timeframe.period,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqClose, qqqEma] = request.security("NASDAQ:QQQ", timeframe.period,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBull   = spyClose > spyEma
bool qqqBull   = qqqClose > qqqEma
bool c1_regime = spyBull and qqqBull

// C1b: TF SUPERIOR — también global, independiente del símbolo
string superTF = f_superTF()

[spyCloseSup, spyEmaSup] = request.security("AMEX:SPY", superTF,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqCloseSup, qqqEmaSup] = request.security("NASDAQ:QQQ", superTF,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool c1_superTF  = spyCloseSup > spyEmaSup and qqqCloseSup > qqqEmaSup
bool superTFGate = not useSuperTF or (superTFRequired ? c1_superTF : true)

// ─── scoreMax GLOBAL ─────────────────────────────────────────
// Idéntico al indicador v5.2 — depende solo de los inputs,
// no del símbolo, así que se calcula una sola vez.
int scoreMax = 5 +
     (useSuperTF and not superTFRequired ? 1 : 0) +
     (useC7      and not c7Required      ? 1 : 0)

// ═══════════════════════════════════════════════════════════════
// FUNCIÓN CENTRAL: f_evalSymbol()
// Recibe los datos OHLCV + ATR de un símbolo (ya extraídos via
// request.security) y devuelve exactamente los mismos valores
// que calcula el indicador Plan A v5.2 para ese símbolo.
//
// GARANTÍA DE PARIDAD: esta función es una copia directa de la
// lógica de cálculo de v5.2 — no una reimplementación — para
// asegurar que scanner e indicador producen SIEMPRE el mismo score.
//
// Devuelve:  [score, fullSignal, partialSignal, slPct, c1ok,
//             c2ok, c3ok, c4ok, c5ok, c6ok, c7ok]
// ═══════════════════════════════════════════════════════════════
//@function Evalua las 7 condiciones Plan A sobre datos OHLCV externos
//@param symClose  (float) close del símbolo escaneado
//@param symOpen   (float) open del símbolo escaneado
//@param symHigh   (float) high del símbolo escaneado
//@param symLow    (float) low del símbolo escaneado
//@param symVol    (float) volume del símbolo escaneado
//@param symAtr    (float) ATR del símbolo escaneado
//@returns [score, full, partial, slPct, c2, c3, c4, c5, c6, c7]
f_evalSymbol(float symClose, float symOpen, float symHigh, float symLow, float symVol, float symAtr) =>

    // C2: Pullback con contexto de tendencia previa
    float emaF = ta.ema(symClose, emaFastLen)
    float emaS = ta.ema(symClose, emaSlowLen)
    int   barsAbove = 0
    for i = 1 to c2TrendBars
        if symClose[i] > emaF[i]
            barsAbove += 1
    bool c2_prior = barsAbove >= c2TrendBars
    bool c2_touch = symLow <= emaF and symClose >= emaS * 0.98
    bool c2       = c2_prior and c2_touch

    // C3: Sobreventa relativa RSI
    float rsi14 = ta.rsi(symClose, rsiLen)
    float rsi2v = ta.rsi(symClose, rsi2Len)
    bool  c3    = rsi14 < rsiOB or rsi2v < rsi2OB

    // C4: RVOL elevado
    float avgVol = ta.sma(symVol, rvolLen)
    bool  c4     = symVol > rvolMult * avgVol

    // C5: Vela de reversión hammer
    float bd  = math.abs(symClose - symOpen)
    float lwk = symOpen > symClose ? (symOpen - symLow)  : (symClose - symLow)
    float uwk = symOpen > symClose ? (symHigh - symOpen) : (symHigh - symClose)
    bool  c5  = lwk >= 2.0 * bd and uwk <= bd and bd > 0.0

    // C6: Tendencia del activo SMA 50/200
    float sma50v  = ta.sma(symClose, sma50Len)
    float sma200v = ta.sma(symClose, sma200Len)
    bool  c6a     = symClose > sma50v
    bool  c6b     = symClose > sma200v
    bool  c6c     = sma50v  > sma200v
    bool  c6      = c6a and c6b and c6c

    // C7: Divergencia alcista RSI
    float rsiDiv   = ta.rsi(symClose, rsiLen)
    float priorLow = ta.lowest(symLow[1],  c7Lookback)
    float priorRsi = ta.lowest(rsiDiv[1],  c7Lookback)
    bool  c7raw    = symLow < priorLow and rsiDiv > priorRsi
    bool  c7       = useC7 and c7raw

    // Gates
    bool c6Gate = c6Required ? c6 : true
    bool c7Gate = not useC7 or not c7Required or c7

    // Score — idéntico al indicador v5.2
    int scoreB  = (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0)
    int scoreS  = (useSuperTF and not superTFRequired and c1_superTF) ? 1 : 0
    int scoreC7 = (useC7 and not c7Required and c7) ? 1 : 0
    int sc      = scoreB + scoreS + scoreC7

    // Señales
    bool full    = c1_regime and superTFGate and c6Gate and c7Gate and sc >= (scoreMax - 1)
    bool partial = c1_regime and superTFGate and c6Gate and c7Gate and sc == (scoreMax - 2)

    // SL%
    float sl    = symLow - atrSlMult * symAtr
    float slPct = symClose > 0 ? (symClose - sl) / symClose * 100 : 0.0

    [sc, full, partial, slPct, c2, c3, c4, c5, c6, c7]

// ─── DATOS POR SÍMBOLO — 1 llamada tuple por símbolo ─────────
// Cada llamada recupera OHLCV + ATR en una sola request.security().
// Anti-repainting: [1] + lookahead_on en todos los valores.

[s1c, s1o, s1h, s1l, s1v, s1a] = request.security(sym1, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

[s2c, s2o, s2h, s2l, s2v, s2a] = request.security(sym2, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

[s3c, s3o, s3h, s3l, s3v, s3a] = request.security(sym3, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

[s4c, s4o, s4h, s4l, s4v, s4a] = request.security(sym4, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

[s5c, s5o, s5h, s5l, s5v, s5a] = request.security(sym5, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

[s6c, s6o, s6h, s6l, s6v, s6a] = request.security(sym6, timeframe.period,
     [close[1], open[1], high[1], low[1], volume[1], ta.atr(atrLen)[1]], lookahead = barmerge.lookahead_on)

// ─── EVALUACIÓN DE LOS 6 SÍMBOLOS ────────────────────────────
[sc1, full1, part1, slp1, c2_1, c3_1, c4_1, c5_1, c6_1, c7_1] = f_evalSymbol(s1c, s1o, s1h, s1l, s1v, s1a)
[sc2, full2, part2, slp2, c2_2, c3_2, c4_2, c5_2, c6_2, c7_2] = f_evalSymbol(s2c, s2o, s2h, s2l, s2v, s2a)
[sc3, full3, part3, slp3, c2_3, c3_3, c4_3, c5_3, c6_3, c7_3] = f_evalSymbol(s3c, s3o, s3h, s3l, s3v, s3a)
[sc4, full4, part4, slp4, c2_4, c3_4, c4_4, c5_4, c6_4, c7_4] = f_evalSymbol(s4c, s4o, s4h, s4l, s4v, s4a)
[sc5, full5, part5, slp5, c2_5, c3_5, c4_5, c5_5, c6_5, c7_5] = f_evalSymbol(s5c, s5o, s5h, s5l, s5v, s5a)
[sc6, full6, part6, slp6, c2_6, c3_6, c4_6, c5_6, c6_6, c7_6] = f_evalSymbol(s6c, s6o, s6h, s6l, s6v, s6a)

// ─── HELPERS TABLA ────────────────────────────────────────────

// Badge resultado compacto
f_resultBadge(bool full, bool partial, int sc) =>
    full ? "READY" : partial ? "WATCH" : "NO GO"

f_resultBg(bool full, bool partial) =>
    full ? C_READY_BG : partial ? C_WARN_BG : C_NOTREADY_BG

f_resultTxt(bool full, bool partial) =>
    full ? C_READY_TXT : partial ? C_WARN_TXT : C_NOTREADY_TXT

// Mini-check condensado: muestra qué condiciones fallan
// Formato: C2 C3 C4 C5 C6 C7 — verde si pasa, rojo si falla
f_condBar(bool c2, bool c3, bool c4, bool c5, bool c6, bool c7) =>
    (c2 ? "2" : "-") + (c3 ? "3" : "-") + (c4 ? "4" : "-") + (c5 ? "5" : "-") + (c6 ? "6" : "-") + (useC7 ? (c7 ? "7" : "-") : "")

// Extrae el ticker limpio desde el símbolo completo (ej. "NASDAQ:AAPL" -> "AAPL")
f_shortTicker(string sym) =>
    int colonPos = str.pos(sym, ":")
    na(colonPos) ? sym : str.substring(sym, colonPos + 1, str.length(sym))

// ─── TABLA SCANNER ────────────────────────────────────────────
// Estructura: 6 columnas (una por símbolo) × 7 filas
//
// Fila 0: Cabecera — ticker de cada símbolo
// Fila 1: Régimen C1 — compartido (mismo para todos)
// Fila 2: Score X/scoreMax
// Fila 3: Condiciones pasadas (mini-check C2-C7)
// Fila 4: SL%
// Fila 5: Resultado READY / WATCH / NO GO
// Fila 6: Versión + TF + fecha

var table t = table.new(tablePos, 7, 8,
     border_color = C_BORDER, border_width = 1,
     frame_color  = color.new(#9ca3af, 0), frame_width = 2)

// Fila 0 — Cabecera lateral + tickers
table.cell(t, 0, 0, "PLAN A SCANNER", text_color = C_HEADER_TXT, text_size = TS,    bgcolor = C_HEADER_BG, text_halign = text.align_left)
table.cell(t, 1, 0, f_shortTicker(sym1), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)
table.cell(t, 2, 0, f_shortTicker(sym2), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)
table.cell(t, 3, 0, f_shortTicker(sym3), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)
table.cell(t, 4, 0, f_shortTicker(sym4), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)
table.cell(t, 5, 0, f_shortTicker(sym5), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)
table.cell(t, 6, 0, f_shortTicker(sym6), text_color = C_TICKER_TXT, text_size = TS, bgcolor = C_HEADER_BG)

// Fila 1 — Régimen C1 (compartido — mismo valor para todos)
string c1txt = c1_regime ? "C1 OK" : "C1 X"
color  c1bg  = c1_regime ? C_PASS_BG : C_FAIL_BG
color  c1tc  = c1_regime ? C_PASS_TXT : C_FAIL_TXT
table.cell(t, 0, 1, "Régimen",      text_color = C_LABEL_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
table.cell(t, 1, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)
table.cell(t, 2, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)
table.cell(t, 3, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)
table.cell(t, 4, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)
table.cell(t, 5, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)
table.cell(t, 6, 1, c1txt,          text_color = c1tc,        text_size = TS_SM, bgcolor = c1bg)

// Fila 2 — Score X/scoreMax
string smStr = "/" + str.tostring(scoreMax)
table.cell(t, 0, 2, "Score",               text_color = C_LABEL_TXT, text_size = TS_SM, bgcolor = C_ROW_BG, text_halign = text.align_left)
table.cell(t, 1, 2, str.tostring(sc1) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)
table.cell(t, 2, 2, str.tostring(sc2) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)
table.cell(t, 3, 2, str.tostring(sc3) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)
table.cell(t, 4, 2, str.tostring(sc4) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)
table.cell(t, 5, 2, str.tostring(sc5) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)
table.cell(t, 6, 2, str.tostring(sc6) + smStr, text_color = C_VALUE_TXT, text_size = TS,    bgcolor = C_ROW_BG)

// Fila 3 — Mini-check condiciones (dígito = pasa, guion = falla)
table.cell(t, 0, 3, "C2-C7",                        text_color = C_LABEL_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
table.cell(t, 1, 3, f_condBar(c2_1,c3_1,c4_1,c5_1,c6_1,c7_1), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
table.cell(t, 2, 3, f_condBar(c2_2,c3_2,c4_2,c5_2,c6_2,c7_2), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
table.cell(t, 3, 3, f_condBar(c2_3,c3_3,c4_3,c5_3,c6_3,c7_3), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
table.cell(t, 4, 3, f_condBar(c2_4,c3_4,c4_4,c5_4,c6_4,c7_4), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
table.cell(t, 5, 3, f_condBar(c2_5,c3_5,c4_5,c5_5,c6_5,c7_5), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)
table.cell(t, 6, 3, f_condBar(c2_6,c3_6,c4_6,c5_6,c6_6,c7_6), text_color = C_VALUE_TXT, text_size = TS_SM, bgcolor = C_ROW_ALT_BG)

// Fila 4 — SL%
table.cell(t, 0, 4, "SL%",                                 text_color = C_LABEL_TXT,      text_size = TS_SM, bgcolor = C_ROW_BG, text_halign = text.align_left)
table.cell(t, 1, 4, "-" + str.tostring(slp1, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 2, 4, "-" + str.tostring(slp2, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 3, 4, "-" + str.tostring(slp3, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 4, 4, "-" + str.tostring(slp4, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 5, 4, "-" + str.tostring(slp5, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 6, 4, "-" + str.tostring(slp6, "#.#") + "%", text_color = color.new(#991b1b,0), text_size = TS_SM, bgcolor = C_ROW_BG)

// Fila 5 — Resultado READY / WATCH / NO GO
table.cell(t, 0, 5, "Resultado",              text_color = C_LABEL_TXT,             text_size = TS_SM, bgcolor = C_ROW_ALT_BG, text_halign = text.align_left)
table.cell(t, 1, 5, f_resultBadge(full1,part1,sc1), text_color = f_resultTxt(full1,part1), text_size = TS, bgcolor = f_resultBg(full1,part1))
table.cell(t, 2, 5, f_resultBadge(full2,part2,sc2), text_color = f_resultTxt(full2,part2), text_size = TS, bgcolor = f_resultBg(full2,part2))
table.cell(t, 3, 5, f_resultBadge(full3,part3,sc3), text_color = f_resultTxt(full3,part3), text_size = TS, bgcolor = f_resultBg(full3,part3))
table.cell(t, 4, 5, f_resultBadge(full4,part4,sc4), text_color = f_resultTxt(full4,part4), text_size = TS, bgcolor = f_resultBg(full4,part4))
table.cell(t, 5, 5, f_resultBadge(full5,part5,sc5), text_color = f_resultTxt(full5,part5), text_size = TS, bgcolor = f_resultBg(full5,part5))
table.cell(t, 6, 5, f_resultBadge(full6,part6,sc6), text_color = f_resultTxt(full6,part6), text_size = TS, bgcolor = f_resultBg(full6,part6))

// Fila 6 — Precio actual
table.cell(t, 0, 6, "Precio",                        text_color = C_LABEL_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG, text_halign = text.align_left)
table.cell(t, 1, 6, str.tostring(s1c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 2, 6, str.tostring(s2c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 3, 6, str.tostring(s3c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 4, 6, str.tostring(s4c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 5, 6, str.tostring(s5c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)
table.cell(t, 6, 6, str.tostring(s6c, "#.##"),        text_color = C_VALUE_TXT,  text_size = TS_SM, bgcolor = C_ROW_BG)

// Fila 7 — Versión + TF
string verStr = "Plan A Screener v1  TF:" + timeframe.period + "  " + str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00")
table.merge_cells(t, 0, 7, 6, 7)
table.cell(t, 0, 7, verStr, text_color = C_DIM_TXT, text_size = TS_SM, bgcolor = C_HEADER_BG)

// ─── ALERTA CONSOLIDADA ───────────────────────────────────────
// Dispara una sola alerta cuando cualquier símbolo pasa a READY.
// El mensaje lista todos los símbolos READY del scan.

string readyList = ""
if full1
    readyList := readyList + f_shortTicker(sym1) + "(" + str.tostring(sc1) + "/" + str.tostring(scoreMax) + ") "
if full2
    readyList := readyList + f_shortTicker(sym2) + "(" + str.tostring(sc2) + "/" + str.tostring(scoreMax) + ") "
if full3
    readyList := readyList + f_shortTicker(sym3) + "(" + str.tostring(sc3) + "/" + str.tostring(scoreMax) + ") "
if full4
    readyList := readyList + f_shortTicker(sym4) + "(" + str.tostring(sc4) + "/" + str.tostring(scoreMax) + ") "
if full5
    readyList := readyList + f_shortTicker(sym5) + "(" + str.tostring(sc5) + "/" + str.tostring(scoreMax) + ") "
if full6
    readyList := readyList + f_shortTicker(sym6) + "(" + str.tostring(sc6) + "/" + str.tostring(scoreMax) + ") "

bool anyReady = full1 or full2 or full3 or full4 or full5 or full6
if anyReady
    alert("PLAN A SCANNER READY | TF: " + timeframe.period + " | " + readyList, alert.freq_once_per_bar_close)

alertcondition(anyReady, title = "Plan A Screener - READY detectado", message = "Plan A Screener: uno o mas simbolos en READY. Revisa el panel.")
