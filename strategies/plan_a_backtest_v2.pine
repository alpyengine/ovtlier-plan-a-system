// ═══════════════════════════════════════════════════════════════
// © Ovtlier University | Plan A Backtest v2
// Basado en la metodología de Christopher Uhl
// Temporalidades: Daily (D) y Weekly (W)
//
// ENTRADA : señal READY del indicador Plan A v5.2 (C1-C7)
// SALIDA  : cuatro modos via input exitMode
//   B — Trailing Stop ATR       (N×ATR, configurable)
//   C — close < EMA fija        (EMA Rapida 9 o EMA Lenta 21)
//   D — ta.crossunder(close, EMA configurable) — v2, nuevo
//   Todos los modos incluyen límite de barras máximo (anti-zombi)
//
// CASO DE ACEPTACION: Modo D con emaExitLenInput=9 debe producir
//   resultados idénticos a Modo C con "EMA Rapida" — verificar
//   exportando CSV completo, no solo dashboard en pantalla.
//
// COSTES  : comisión 0,05% + slippage 0,05% (IB)
// CRITERIO: Profit Factor > 1,2x sobre Buy & Hold
// ═══════════════════════════════════════════════════════════════
//@version=6
strategy("Ovtlier Plan A - Backtest v2",
     overlay             = true,
     pyramiding          = 0,
     default_qty_type    = strategy.percent_of_equity,
     default_qty_value   = 100,
     commission_type     = strategy.commission.percent,
     commission_value    = 0.05,
     slippage            = 1,
     max_bars_back       = 500)

// ─── INPUTS — RÉGIMEN C1 ──────────────────────────────────────
spyEmaLen       = input.int(20,    "EMA Régimen SPY",             group = "📊 Régimen C1", minval = 5)
qqqEmaLen       = input.int(20,    "EMA Régimen QQQ",             group = "📊 Régimen C1", minval = 5)
useSuperTF      = input.bool(false, "Activar doble TF (C1 superior)", group = "📊 Régimen C1")
superTFRequired = input.bool(false, "TF superior obligatorio",    group = "📊 Régimen C1")

// ─── INPUTS — PARÁMETROS TÉCNICOS ─────────────────────────────
emaFastLen  = input.int(9,     "EMA Rápida",               group = "📊 Técnicos", minval = 3)
emaSlowLen  = input.int(21,    "EMA Lenta",                group = "📊 Técnicos", minval = 5)
rsiLen      = input.int(14,    "RSI Longitud",             group = "📊 Técnicos", minval = 2)
rsiOB       = input.int(40,    "RSI Umbral Sobreventa",    group = "📊 Técnicos", minval = 10, maxval = 50)
rsi2Len     = input.int(2,     "RSI-2 Longitud",           group = "📊 Técnicos", minval = 1)
rsi2OB      = input.float(10.0,"RSI-2 Umbral",             group = "📊 Técnicos", minval = 1.0, maxval = 30.0)
rvolMult    = input.float(1.5, "RVOL Multiplicador",       group = "📊 Técnicos", minval = 1.0, step = 0.1)
rvolLen     = input.int(20,    "RVOL Longitud",            group = "📊 Técnicos", minval = 5)
c2TrendBars = input.int(3,     "C2 Barras tendencia previa", group = "📊 Técnicos", minval = 1, maxval = 10)
sma50Len    = input.int(50,    "SMA 50",                   group = "📊 Técnicos", minval = 10)
sma200Len   = input.int(200,   "SMA 200",                  group = "📊 Técnicos", minval = 50)
c6Required  = input.bool(false, "C6 obligatoria",          group = "📊 Técnicos")
useC7       = input.bool(true,  "Activar C7 Divergencia",  group = "📊 Técnicos")
c7Lookback  = input.int(5,     "C7 Ventana barras",        group = "📊 Técnicos", minval = 2, maxval = 20)
c7Required  = input.bool(false, "C7 obligatoria",          group = "📊 Técnicos")
atrLen      = input.int(14,    "ATR Longitud",             group = "📊 Técnicos", minval = 1)
atrSlMult   = input.float(1.5, "ATR Stop-Loss inicial x",  group = "📊 Técnicos", minval = 0.5, step = 0.1)

// ─── INPUTS — SALIDA ──────────────────────────────────────────
exitMode    = input.string("B - Trailing ATR", "Modo de salida",
     options = ["B - Trailing ATR", "C - Cruce EMA", "D - Crossunder EMA configurable"],
     group = "🚪 Salida",
     tooltip = "B: trailing stop ATR.\nC: close < EMA fija (rapida 9 o lenta 21).\nD: ta.crossunder(close, EMA configurable) — EMA independiente de las de entrada.")

trailAtrMult = input.float(2.0, "B — Trailing ATR multiplicador", group = "🚪 Salida", minval = 0.5, step = 0.1,
     tooltip = "Distancia del trailing stop al precio en unidades de ATR.\nDefault 2.0.")

maxBarsHold  = input.int(10,   "Max barras en posicion",   group = "🚪 Salida", minval = 1, maxval = 50,
     tooltip = "Cierre a mercado si la posicion lleva N barras sin que se active ninguna salida.\nEvita posiciones zombi.")

exitEmaMode  = input.string("EMA Rapida", "C — Cruce sobre",
     options = ["EMA Rapida", "EMA Lenta"],
     group = "🚪 Salida",
     tooltip = "C: cierre cuando close cierra bajo la EMA rapida (9) o lenta (21).")

// Modo D — EMA de salida independiente
// Completamente separada de emaFast (usada en C2 pullback) y emaSlow.
// Con emaExitLenInput = 9, Modo D debe ser identico a Modo C con EMA Rapida.
emaExitLenInput = input.int(21, "D — EMA Salida (periodos)", group = "🚪 Salida", minval = 2,
     tooltip = "Longitud de la EMA usada como trigger de salida en Modo D.\nCompletamente independiente de las EMAs de entrada (C2, C5).\nCASO ACEPTACION: con valor 9 debe dar resultados identicos a Modo C con EMA Rapida.")

// ─── HELPER: TF SUPERIOR ─────────────────────────────────────
f_superTF() =>
    if timeframe.isweekly or timeframe.ismonthly
        "M"
    else
        "W"

// ─── C1: RÉGIMEN BROAD MARKET ────────────────────────────────
// Anti-repainting: close[1] + lookahead_on. Idéntico al indicador v5.2.
[spyClose, spyEma] = request.security("AMEX:SPY", timeframe.period,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqClose, qqqEma] = request.security("NASDAQ:QQQ", timeframe.period,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool spyBull   = spyClose > spyEma
bool qqqBull   = qqqClose > qqqEma
bool c1_regime = spyBull and qqqBull

// C1b: TF SUPERIOR
string superTF = f_superTF()

[spyCloseSup, spyEmaSup] = request.security("AMEX:SPY", superTF,
     [close[1], ta.ema(close, spyEmaLen)[1]], lookahead = barmerge.lookahead_on)

[qqqCloseSup, qqqEmaSup] = request.security("NASDAQ:QQQ", superTF,
     [close[1], ta.ema(close, qqqEmaLen)[1]], lookahead = barmerge.lookahead_on)

bool c1_superTF  = spyCloseSup > spyEmaSup and qqqCloseSup > qqqEmaSup
bool superTFGate = not useSuperTF or (superTFRequired ? c1_superTF : true)

// ─── CÁLCULOS TÉCNICOS ────────────────────────────────────────
// Idénticos al indicador v5.2 — misma lógica, mismo orden.

// C2: Pullback con contexto de tendencia previa
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)

int barsAboveEma = 0
for i = 1 to c2TrendBars
    if close[i] > emaFast[i]
        barsAboveEma += 1

bool c2_prior  = barsAboveEma >= c2TrendBars
bool c2_touch  = low <= emaFast and close >= emaSlow * 0.98
bool c2        = c2_prior and c2_touch

// C3: Sobreventa relativa
float rsiVal  = ta.rsi(close, rsiLen)
float rsi2Val = ta.rsi(close, rsi2Len)
bool  c3      = rsiVal < rsiOB or rsi2Val < rsi2OB

// C4: RVOL elevado
float avgVol    = ta.sma(volume, rvolLen)
bool  c4        = volume > rvolMult * avgVol

// C5: Vela hammer
float body   = math.abs(close - open)
float lowerW = open > close ? (open - low)  : (close - low)
float upperW = open > close ? (high - open) : (high - close)
bool  c5     = lowerW >= 2.0 * body and upperW <= body and body > 0.0

// C6: Tendencia del activo SMA 50/200
float sma50  = ta.sma(close, sma50Len)
float sma200 = ta.sma(close, sma200Len)
bool  c6     = close > sma50 and close > sma200 and sma50 > sma200

// C7: Divergencia alcista RSI
float rsiDiv   = ta.rsi(close, rsiLen)
float priorLow = ta.lowest(low[1],    c7Lookback)
float priorRsi = ta.lowest(rsiDiv[1], c7Lookback)
bool  c7raw    = low < priorLow and rsiDiv > priorRsi
bool  c7       = useC7 and c7raw

// ─── SCORING — idéntico al indicador v5.2 ────────────────────
bool c6Gate  = c6Required ? c6 : true
bool c7Gate  = not useC7 or not c7Required or c7

int scoreMax = 5 + (useSuperTF and not superTFRequired ? 1 : 0) + (useC7 and not c7Required ? 1 : 0)
int scoreB   = (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0)
int scoreS   = (useSuperTF and not superTFRequired and c1_superTF) ? 1 : 0
int scoreC7  = (useC7 and not c7Required and c7) ? 1 : 0
int score    = scoreB + scoreS + scoreC7

// Solo señal READY (score >= scoreMax-1) — decisión de diseño backtest/v1
bool entrySignal = c1_regime and superTFGate and c6Gate and c7Gate and score >= (scoreMax - 1)

// ─── ATR PARA STOP INICIAL Y TRAILING ────────────────────────
float atrVal      = ta.atr(atrLen)
float slInitial   = low - atrSlMult * atrVal        // stop inicial bajo el low de la barra de entrada
float trailDist   = trailAtrMult * atrVal           // distancia trailing en precio
float trailTicks  = trailDist / syminfo.mintick     // convertido a ticks para strategy.exit

// ─── EMA PARA MODO C ─────────────────────────────────────────
float exitEma     = exitEmaMode == "EMA Rapida" ? emaFast : emaSlow

// EMA PARA MODO D
// Longitud configurable via emaExitLenInput — independiente de emaFast y emaSlow.
// No afecta ninguna condicion de entrada (C1-C7).
// Caso de aceptacion: con emaExitLenInput=9, emaExit == emaFast numericamente.
float emaExit = ta.ema(close, emaExitLenInput)

// ─── BARRA LIMITE — posicion zombi ───────────────────────────
// Calcula cuántas barras lleva abierta la posición actual.
// Usa strategy.opentrades.entry_bar_index() — patrón documentado en la referencia.
int barsInTrade = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : 0
bool maxBarsHit = strategy.position_size > 0 and barsInTrade >= maxBarsHold

// ─── LÓGICA DE ENTRADA ───────────────────────────────────────
// Una posición a la vez (pyramiding = 0).
// Entrada al cierre de la barra que genera la señal READY.

if entrySignal and strategy.position_size == 0
    strategy.entry("PlanA Long", strategy.long, comment = "READY " + str.tostring(score) + "/" + str.tostring(scoreMax))

// ─── LÓGICA DE SALIDA — MODO B: TRAILING ATR ─────────────────
// strategy.exit() con stop inicial + trailing por ticks.
// Se restablece en cada nueva entrada porque strategy.exit se llama
// solo cuando hay posición abierta.
// El trailing sigue el precio hacia arriba; nunca retrocede.

if exitMode == "B - Trailing ATR" and strategy.position_size > 0
    strategy.exit("PlanA Exit B", from_entry = "PlanA Long",
         stop          = slInitial,
         trail_offset  = trailTicks,
         comment       = "Trail ATR")

// ─── LÓGICA DE SALIDA — MODO C: CRUCE EMA ────────────────────
// Cierra cuando el precio cierra por debajo de la EMA seleccionada.
// Solo se evalúa si hay posición abierta.

bool exitSignalC = exitMode == "C - Cruce EMA" and strategy.position_size > 0 and close < exitEma

if exitSignalC
    strategy.close("PlanA Long", comment = "Cruce EMA")

// Modo C necesita también el stop inicial como protección de pérdida máxima
if exitMode == "C - Cruce EMA" and strategy.position_size > 0
    strategy.exit("PlanA SL C", from_entry = "PlanA Long",
         stop    = slInitial,
         comment = "SL inicial")

// MODO D: CROSSUNDER EMA CONFIGURABLE
// ta.crossunder detecta el momento exacto en que close cruza bajo emaExit.
// Diferencia con Modo C: C usa close < exitEma (nivel), D usa crossunder (evento).
// Con emaExitLenInput = 9 los resultados deben ser identicos a Modo C EMA Rapida
// porque ambos detectan el primer cierre bajo la EMA — verificar con CSV completo.

bool exitSignalD = exitMode == "D - Crossunder EMA configurable" and strategy.position_size > 0 and ta.crossunder(close, emaExit)

if exitSignalD
    strategy.close("PlanA Long", comment = "Crossunder EMA" + str.tostring(emaExitLenInput))

// Modo D necesita stop inicial como proteccion de perdida maxima (igual que Modo C)
if exitMode == "D - Crossunder EMA configurable" and strategy.position_size > 0
    strategy.exit("PlanA SL D", from_entry = "PlanA Long",
         stop    = slInitial,
         comment = "SL inicial")

// CIERRE ZOMBI — TODOS LOS MODOS
// Si se alcanza el maximo de barras, cierre a mercado sin condiciones.
// Sobrescribe cualquier orden pendiente.

if maxBarsHit
    strategy.close("PlanA Long", comment = "MaxBars " + str.tostring(maxBarsHold))

// ─── PLOTS ────────────────────────────────────────────────────
plot(emaFast, "EMA Rapida",  color.new(color.blue,   0), 1)
plot(emaSlow, "EMA Lenta",   color.new(color.orange, 0), 2)
plot(sma50,   "SMA 50",      color.new(color.purple, 0), 1)
plot(sma200,  "SMA 200",     color.new(color.yellow, 0), 2)

// Señales de entrada en el gráfico
plotshape(entrySignal and strategy.position_size == 0, "Entrada READY",
     shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.normal, text = "A")

// Línea del stop inicial cuando hay posición abierta (Modo B y C)
plot(strategy.position_size > 0 ? slInitial : na, "SL Inicial",
     color.new(color.red, 20), 1, plot.style_linebr)

// Linea EMA de salida — Modo C
plot(exitMode == "C - Cruce EMA" and strategy.position_size > 0 ? exitEma : na, "EMA Salida C",
     color.new(color.fuchsia, 0), 1, plot.style_linebr)

// Linea EMA de salida — Modo D (configurable, verde azulado)
plot(exitMode == "D - Crossunder EMA configurable" and strategy.position_size > 0 ? emaExit : na, "EMA Salida D",
     color.new(color.teal, 0), 2, plot.style_linebr)

// ─── DASHBOARD — paleta clara, sin gate barstate (Bar Replay) ─
// Tabla 2 columnas x 12 filas — actualizada cada barra sin gate.

var table dash = table.new(position.top_right, 2, 13,
     bgcolor      = color.white,
     border_width = 1,
     border_color = color.new(color.gray, 40),
     frame_width  = 1,
     frame_color  = color.new(color.gray, 40))

// Fila 0 — Cabecera
table.cell(dash, 0, 0, "PLAN A BACKTEST v1", bgcolor = color.new(color.gray, 20), text_color = color.black, text_size = size.small)
table.cell(dash, 1, 0, "v2 | " + exitMode,  bgcolor = color.new(color.gray, 20), text_color = color.black, text_size = size.small)

// Fila 1 — Ticker + TF
table.cell(dash, 0, 1, syminfo.ticker + " / " + timeframe.period, text_color = color.new(#1d4ed8, 0), text_size = size.small)
table.cell(dash, 1, 1, str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00"), text_color = color.gray, text_size = size.tiny)

// Fila 2 — Régimen
table.cell(dash, 0, 2, "Régimen C1", text_color = color.black, text_size = size.small)
table.cell(dash, 1, 2, c1_regime ? "OK  SPY+QQQ" : "FAIL",
     bgcolor     = c1_regime ? color.new(color.green, 70) : color.new(color.red, 70),
     text_color  = color.black, text_size = size.small)

// Fila 3 — Score actual
table.cell(dash, 0, 3, "Score",      text_color = color.black, text_size = size.small)
table.cell(dash, 1, 3, str.tostring(score) + "/" + str.tostring(scoreMax),
     bgcolor    = entrySignal ? color.new(color.green, 70) : color.new(color.gray, 80),
     text_color = color.black, text_size = size.small)

// Fila 4 — Posición actual
bool inTrade = strategy.position_size > 0
table.cell(dash, 0, 4, "Posicion",   text_color = color.black, text_size = size.small)
table.cell(dash, 1, 4, inTrade ? "LONG  " + str.tostring(barsInTrade) + "b" : "Flat",
     bgcolor    = inTrade ? color.new(color.teal, 70) : color.new(color.gray, 80),
     text_color = color.black, text_size = size.small)

// Fila 5 — SL inicial
table.cell(dash, 0, 5, "SL inicial", text_color = color.black, text_size = size.small)
table.cell(dash, 1, 5, inTrade ? str.tostring(slInitial, "#.##") : "—",
     text_color = color.new(color.red, 0), text_size = size.small)

// Fila 6 — Barras en trade vs límite
table.cell(dash, 0, 6, "Barras / Max", text_color = color.black, text_size = size.small)
table.cell(dash, 1, 6, inTrade ? str.tostring(barsInTrade) + " / " + str.tostring(maxBarsHold) : "—",
     bgcolor    = maxBarsHit ? color.new(color.orange, 60) : color.new(color.gray, 85),
     text_color = color.black, text_size = size.small)

// Fila 7 — Trades totales
table.cell(dash, 0, 7, "Trades",     text_color = color.black, text_size = size.small)
table.cell(dash, 1, 7, str.tostring(strategy.closedtrades), text_color = color.black, text_size = size.small)

// Fila 8 — Win Rate
float winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
table.cell(dash, 0, 8, "Win Rate",   text_color = color.black, text_size = size.small)
table.cell(dash, 1, 8, str.tostring(winRate, "#.#") + "%",
     bgcolor    = winRate >= 50 ? color.new(color.green, 75) : color.new(color.red, 75),
     text_color = color.black, text_size = size.small)

// Fila 9 — Profit Factor
float pf = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : na
table.cell(dash, 0, 9, "Profit Factor", text_color = color.black, text_size = size.small)
table.cell(dash, 1, 9, na(pf) ? "—" : str.tostring(pf, "#.##"),
     bgcolor    = not na(pf) and pf >= 1.2 ? color.new(color.green, 70) : color.new(color.red, 75),
     text_color = color.black, text_size = size.small)

// Fila 10 — Net Profit %
float netPct = strategy.netprofit / strategy.initial_capital * 100
table.cell(dash, 0, 10, "Net Profit",   text_color = color.black, text_size = size.small)
table.cell(dash, 1, 10, str.tostring(netPct, "#.##") + "%",
     bgcolor    = netPct >= 0 ? color.new(color.green, 75) : color.new(color.red, 75),
     text_color = color.black, text_size = size.small)

// Fila 11 — Max Drawdown %
table.cell(dash, 0, 11, "Max DD",      text_color = color.black, text_size = size.small)
table.cell(dash, 1, 11, str.tostring(strategy.max_drawdown_percent, "#.##") + "%",
     text_color = color.new(color.red, 0), text_size = size.small)

// Fila 12 — Costes
table.cell(dash, 0, 12, "Costes",      text_color = color.gray, text_size = size.tiny)
table.cell(dash, 1, 12, "Com 0.05%  Slip 0.05%", text_color = color.gray, text_size = size.tiny)
